@model List<MultiserviciosPiscinas.Models.GastoOperativo>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Gastos Operativos";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>Gastos Operativos</h2>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Registrar gasto</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaGastosOperativos" class="table table-hover align-middle">
                <thead class="table-light">
            <tr>
                <th>Fecha</th>
                <th>Categoría</th>
                <th>Monto</th>
                <th>Descripción</th>
                <th>Registrado por</th>
                <th>Estado</th>
                <th class="text-center">Comprobante</th>
                
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int c = 1;
                foreach (var g in Model)
                {
                    <tr>
                        <td>@g.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@g.Categoria.NombreCategoria</td>
                        <td class="c-price">₡@g.Monto.ToString("N2")</td>
                        <td class="c-muted">@(g.Descripcion ?? "—")</td>
                        <td>@g.Usuario.Nombre @g.Usuario.ApellidoPaterno</td>
                        <td>
                            @if (g.Estado == "Aprobado")
                            {
                                <span class="c-badge c-badge-green">Aprobado</span>
                            }
                            else if (g.Estado == "Pendiente")
                            {
                                <span class="c-badge c-badge-amber">Pendiente</span>
                            }
                            else
                            {
                                <span class="c-badge c-badge-red">Rechazado</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(g.ComprobanteRuta))
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a href="@g.ComprobanteRuta" target="_blank" class="dropdown-item">
                                                <i class="bi bi-eye me-2 text-info"></i>Ver
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-file-earmark-x me-1"></i>Sin archivo
                                </span>
                            }
                        </td>
                        
                    </tr>
                    c++;
                }
            }
        </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/gasto-operativo-tabla.js" asp-append-version="true"></script>
}

