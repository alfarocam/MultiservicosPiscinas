@model List<MultiserviciosPiscinas.Models.GastoOperativo>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Gastos Operativos";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>Gastos Operativos</h2>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
            <i class="bi bi-tags me-1"></i>Nueva categoría
        </button>
        <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Registrar gasto</a>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaGastosOperativos" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Categoría</th>
                        <th>Monto</th>
                        <th>Descripción</th>
                        <th>Registrado por</th>
                        <th>Comprobante</th>
                        <th>Estado</th>
                        <th>Motivo Rechazo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var g in Model)
                        {
                            <tr>
                                <td data-order="@g.Fecha.ToString("yyyyMMdd")">@g.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@(g.Categoria?.NombreCategoria ?? "General")</td>
                                <td class="c-price">₡@g.Monto.ToString("N2")</td>
                                <td class="c-muted">@(g.Descripcion ?? "—")</td>
                                <td>@(g.Usuario != null ? $"{g.Usuario.Nombre} {g.Usuario.ApellidoPaterno}" : "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(g.ComprobanteRuta))
                                    {
                                        <span class="small">
                                            <i class="bi bi-file-check me-1 text-success"></i>Comprobante adjunto
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="bi bi-file-earmark-x me-1 text-danger"></i>Sin comprobante
                                        </span>
                                    }
                                </td>
                                <td data-order="@(g.Estado == "Pendiente" ? 1 : (g.Estado == "Aprobado" ? 2 : 3))">
                                    @if (g.Estado == "Aprobado")
                                    {
                                        <span class="c-badge c-badge-green">Aprobado</span>
                                    }
                                    else if (g.Estado == "Pendiente")
                                    {
                                        <span class="c-badge c-badge-amber">Pendiente</span>
                                    }
                                    else
                                    {
                                        <span class="c-badge c-badge-red">Rechazado</span>
                                    }
                                </td>
                                <td>
                                    @if (g.Estado == "Rechazado")
                                    {
                                        <span class="text-danger small fw-bold"><i class="bi bi-exclamation-circle me-1"></i>@g.MotivoRechazo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a asp-action="Detalle" asp-route-id="@g.Id" class="dropdown-item">
                                                    <i class="bi bi-eye me-2 text-info"></i>Ver detalle
                                                </a>
                                            </li>
                                            @if (g.Estado == "Pendiente")
                                            {
                                                <li>
                                                    <form asp-action="Aprobar" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@g.Id" />
                                                        <button type="submit" class="dropdown-item text-success" title="Aprobar">
                                                            <i class="bi bi-check-lg me-2 text-success"></i>Aprobar
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#modalRechazar-@g.Id" title="Rechazar">
                                                        <i class="bi bi-x-lg me-2 text-danger"></i>Rechazar
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    foreach (var g in Model.Where(x => x.Estado == "Pendiente"))
    {
        <div class="modal fade" id="modalRechazar-@g.Id" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-start">
                    <form asp-action="Rechazar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@g.Id" />

                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title fs-6"><i class="bi bi-exclamation-triangle-fill me-2"></i>Motivo de Rechazo</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            <label class="form-label fw-bold text-dark">Escriba la justificación:</label>
                            <textarea name="motivoRechazo" class="form-control" rows="3" required placeholder="Ej: La foto del comprobante no es legible..."></textarea>
                        </div>

                        <div class="modal-footer bg-light d-flex justify-content-end">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-check-circle-fill me-1"></i>Confirmar Rechazo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<div class="modal fade" id="modalCrearCategoria" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-start">
            <form asp-controller="GastoOperativo" asp-action="CrearCategoria" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fs-6"><i class="bi bi-tags-fill me-2"></i>Nueva Categoría de Gasto</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <label for="nombreCategoriaOperativo" class="form-label fw-bold text-dark">Nombre de la categoría:</label>
                    <input type="text" id="nombreCategoriaOperativo" name="nombreCategoria" class="form-control" maxlength="100" required placeholder="Ej: Combustible, Viáticos, Materiales..." />
                </div>

                <div class="modal-footer bg-light d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle-fill me-1"></i>Guardar categoría
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/gasto-operativo-tabla.js" asp-append-version="true"></script>
}

