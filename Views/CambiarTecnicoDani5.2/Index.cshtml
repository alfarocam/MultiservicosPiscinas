@model IEnumerable<MultiserviciosPiscinas.Models.Servicio>

@{
    ViewData["Title"] = "Gestión de Tecnicos prueba Dani";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-badge text-primary"></i> Control de Técnicos (5.2 Dani)</h2>
        <span class="badge bg-info text-dark">HU-5.2 - Módulo de Dani</span>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Servicios Activos y Técnicos Asignados</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID Servicio</th>
                        <th>Fecha Apertura</th>
                        <th>Estado</th>
                        <th>Cliente</th>
                        <th>Técnico Actual</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>@item.FechaApertura.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(item.Estado == "Pendiente" ? "bg-warning text-dark" : "bg-success")">
                                    @item.Estado
                                </span>
                            </td>
                            <td>
                                @(item.Cita?.Piscina?.Cliente?.Usuario?.Nombre ?? "N/A")
                                @(item.Cita?.Piscina?.Cliente?.Usuario?.ApellidoPaterno ?? "")
                                @(item.Cita?.Piscina?.Cliente?.Usuario?.ApellidoMaterno ?? "")
                            </td>
                            <td>
                                <span class="fw-bold text-secondary">
                                    <i class="bi bi-person-fill"></i>
                                    @(item.Cita?.Tecnico?.Nombre ?? "No Asignado")
                                    @(item.Cita?.Tecnico?.ApellidoPaterno ?? "")
                                    @(item.Cita?.Tecnico?.ApellidoMaterno ?? "")
                                </span>
                            </td>
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalCambioTecnico"
                                        data-servicioid="@item.Id"
                                        data-tecnicoid="@item.Cita?.TecnicoId"
                                        data-tecniconombre="@item.Cita?.Tecnico?.Nombre @item.Cita?.Tecnico?.ApellidoPaterno @item.Cita?.Tecnico?.ApellidoMaterno">
                                    <i class="bi bi-arrow-left-right"></i> Cambiar Técnico
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCambioTecnico" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalLabel"><i class="bi bi-person-gear"></i> Asignar Nuevo Técnico</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Asignar" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <input type="hidden" id="modalServicioId" name="servicioId" />

                    <div class="mb-3">
                        <label class="form-label text-muted">Servicio Seleccionado:</label>
                        <input type="text" id="modalServicioTexto" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Técnico Actual:</label>
                        <input type="text" id="modalTecnicoActual" class="form-control bg-light text-danger fw-bold" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Seleccionar Nuevo Técnico:</label>
                        <select class="form-select" name="nuevoTecnicoId" asp-items="ViewBag.Tecnicos" required>
                            <option value="">-- Elija un técnico disponible --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var modalElement = document.getElementById('modalCambioTecnico');
        modalElement.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var servicioId = button.getAttribute('data-servicioid');
            var tecnicoNombre = button.getAttribute('data-tecniconombre');

            document.getElementById('modalServicioId').value = servicioId;
            document.getElementById('modalServicioTexto').value = "Servicio #" + servicioId;
            document.getElementById('modalTecnicoActual').value = (tecnicoNombre && tecnicoNombre.trim() !== "") ? tecnicoNombre : "Sin asignar";
        });
    </script>
}