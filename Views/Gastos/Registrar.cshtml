@model MultiserviciosPiscinas.Models.GastoOperativo

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Registrar Gasto";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Registrar Nuevo Gasto</h2>
    <a asp-action="Index" class="btn btn-success"><i class="bi bi-arrow-left me-1"></i>Volver</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Registrar" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label fw-bold">Tipo de Gasto / Categoría</label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias" required>
                        <option value="">-- Seleccione una categoría --</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="Monto" class="form-label fw-bold">Monto (₡)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                </div>

                <div class="col-md-3">
                    <label asp-for="CitaId" class="form-label fw-bold">Cita Asociada (Opcional)</label>
                    <input asp-for="CitaId" type="number" class="form-control" placeholder="Ej: 1002" />
                </div>

                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción / Detalle del Gasto</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalle que compro o el motivo del viático."></textarea>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">Foto del Comprobante / Recibo</label>
                    <input type="file" name="comprobanteArchivo" class="form-control" accept="image/*,application/pdf" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Registrar gasto
                </button>
            </div>
        </form>
    </div>
</div>