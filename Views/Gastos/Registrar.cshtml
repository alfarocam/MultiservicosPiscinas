@model MultiserviciosPiscinas.Models.GastoOperativo

@{
    ViewData["Title"] = "Registrar Gasto";
    bool esAdmin = User.IsInRole("1");
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Registrar Nuevo Gasto</h2>
    <a asp-action="Index" class="btn btn-success"><i class="bi bi-arrow-left me-1"></i>Volver</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form id="formRegistrarGasto" asp-action="Registrar" method="post" enctype="multipart/form-data" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="CategoriaId" class="form-label fw-bold mb-0">Tipo de Gasto / Categoría</label>
                        @if (esAdmin)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
                                <i class="bi bi-plus-circle me-1"></i>Nueva categoría
                            </button>
                        }
                    </div>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                        <option value="">-- Seleccione una categoría --</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Monto" class="form-label fw-bold">Monto (₡)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control" placeholder="0.00"
                           value="@(Model.Monto > 0 ? Model.Monto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    <span asp-validation-for="Monto" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Fecha" class="form-label fw-bold">Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CitaId" class="form-label fw-bold">Cita Asociada (Opcional)</label>
                    <input asp-for="CitaId" type="number" class="form-control" placeholder="Ej: 1002" />
                    <span asp-validation-for="CitaId" class="text-danger small"></span>
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-bold">Foto del Comprobante / Recibo</label>
                    <input type="file" name="comprobanteArchivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf,image/*,application/pdf" />
                    <span class="text-danger small" data-valmsg-for="comprobanteArchivo">@Html.ValidationMessage("comprobanteArchivo")</span>
                    <div class="form-text">Sin comprobante el gasto se rechaza automáticamente (JPG, PNG o PDF).</div>
                </div>

                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción / Detalle del Gasto</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalle qué compró o el motivo del gasto."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Registrar gasto
                </button>
            </div>
        </form>
    </div>
</div>

@if (esAdmin)
{
    <div class="modal fade" id="modalCrearCategoria" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-start">
                <form id="formCrearCategoria" asp-controller="Gastos" asp-action="CrearCategoria" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fs-6"><i class="bi bi-tags-fill me-2"></i>Nueva Categoría de Gasto</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <label for="nombreCategoriaRegistrar" class="form-label fw-bold text-dark">Nombre de la categoría:</label>
                        <input type="text" id="nombreCategoriaRegistrar" name="nombreCategoria" class="form-control" maxlength="100" placeholder="Ej: Combustible, Viáticos, Materiales..." />
                        <span class="text-danger small" data-valmsg-for="nombreCategoria"></span>
                    </div>

                    <div class="modal-footer bg-light d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle-fill me-1"></i>Guardar categoría
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/gastos-form.js" asp-append-version="true"></script>
}