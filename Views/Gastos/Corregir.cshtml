@model MultiserviciosPiscinas.Models.GastoOperativo

@{
    ViewData["Title"] = "Corregir Gasto Rechazado";
    bool tieneComprobante = !string.IsNullOrEmpty(Model.ComprobanteRuta);
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Corregir Gasto Rechazado</h2>
    <a asp-action="Index" class="btn btn-success"><i class="bi bi-arrow-left me-1"></i>Volver</a>
</div>

<div class="alert alert-danger shadow-sm mb-4">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Motivo del rechazo por el Administrador:</strong> @(string.IsNullOrWhiteSpace(Model.MotivoRechazo) ? "—" : Model.MotivoRechazo)
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form id="formCorregirGasto" asp-action="Corregir" method="post" enctype="multipart/form-data" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                        <option value="">-- Seleccione una categoría --</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Monto" class="form-label fw-bold">Monto (₡)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control"
                           value="@(Model.Monto > 0 ? Model.Monto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    <span asp-validation-for="Monto" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="CitaId" class="form-label fw-bold">Cita Asociada (Opcional)</label>
                    <input asp-for="CitaId" type="number" class="form-control" />
                    <span asp-validation-for="CitaId" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción Corregida</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">
                        @(tieneComprobante ? "Subir Nuevo Comprobante (Opcional)" : "Subir Comprobante (Requerido para pasar a Pendiente)")
                    </label>
                    <div class="mb-2">
                        @if (tieneComprobante)
                        {
                            <span class="small text-success me-2">
                                <i class="bi bi-file-check me-1"></i>Comprobante actual adjunto.
                            </span>
                            <a href="@Model.ComprobanteRuta" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Ver comprobante actual
                            </a>
                        }
                        else
                        {
                            <span class="small text-danger">
                                <i class="bi bi-file-earmark-x me-1"></i>Este gasto no tiene comprobante adjunto.
                            </span>
                        }
                    </div>
                    <input type="file" name="comprobanteArchivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf,image/*,application/pdf" />
                    <span class="text-danger small" data-valmsg-for="comprobanteArchivo">@Html.ValidationMessage("comprobanteArchivo")</span>
                    <div class="form-text">Para que el gasto vuelva a estado Pendiente de aprobación debe contar con un comprobante adjunto.</div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-send me-1"></i> Reenviar Corrección</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/gastos-form.js" asp-append-version="true"></script>
}