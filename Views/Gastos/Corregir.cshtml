@model MultiserviciosPiscinas.Models.GastoOperativo

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Corregir Gasto Rechazado";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Corregir Gasto Rechazado</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

<div class="alert alert-danger shadow-sm mb-4">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Motivo del rechazo por el Administrador:</strong> @Model.MotivoRechazo
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Corregir" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias" required></select>
                </div>

                <div class="col-md-3">
                    <label asp-for="Monto" class="form-label fw-bold">Monto (₡)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control" required />
                </div>

                <div class="col-md-3">
                    <label asp-for="CitaId" class="form-label fw-bold">Cita Asociada (Opcional)</label>
                    <input asp-for="CitaId" type="number" class="form-control" />
                </div>

                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción Corregida</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">Subir Nuevo Comprobante (Opcional)</label>
                    <input type="file" name="comprobanteArchivo" class="form-control" accept="image/*,application/pdf" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-send me-1"></i> Reenviar Corrección</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>