@model MultiserviciosPiscinas.Models.GastoOperativo

@{
    ViewData["Title"] = "Detalle del Gasto";

    // Controlador al que regresa el botón Volver (Gastos o GastoOperativo).
    string volverController = ViewBag.VolverController ?? "Gastos";
    bool esAdmin = User.IsInRole("1");
    bool esTecnico = User.IsInRole("2");

    bool tieneComprobante = !string.IsNullOrEmpty(Model.ComprobanteRuta);
    bool esPdf = tieneComprobante && Model.ComprobanteRuta!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

    var badgeClass = Model.Estado switch
    {
        "Aprobado" => "c-badge-green",
        "Pendiente" => "c-badge-amber",
        _ => "c-badge-red"
    };
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Detalle del gasto</h2>
    <a asp-controller="@volverController" asp-action="Index" class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <span class="c-badge @badgeClass mb-3 d-inline-block">@Model.Estado</span>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="a-text-muted small">Registrado por</div>
                <div class="fw-semibold">@Model.Usuario.Nombre @Model.Usuario.ApellidoPaterno @Model.Usuario.ApellidoMaterno</div>
                <div class="small text-muted">@Model.Usuario.Correo</div>
            </div>
            <div class="col-md-4">
                <div class="a-text-muted small">Fecha del gasto</div>
                <div class="fw-semibold">@Model.Fecha.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-4">
                <div class="a-text-muted small">Categoría</div>
                <div class="fw-semibold">@Model.Categoria.NombreCategoria</div>
            </div>
            <div class="col-md-4">
                <div class="a-text-muted small">Monto</div>
                <div class="fw-semibold">₡@Model.Monto.ToString("N2")</div>
            </div>
            <div class="col-md-4">
                <div class="a-text-muted small">Cita asociada</div>
                @if (Model.Cita != null)
                {
                    <div class="fw-semibold">Cita #@Model.Cita.Id — @Model.Cita.Tipo</div>
                    <div class="small text-muted">@Model.Cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</div>
                }
                else
                {
                    <div class="fw-semibold">—</div>
                }
            </div>
            <div class="col-md-12">
                <div class="a-text-muted small">Descripción</div>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "—" : Model.Descripcion)</div>
            </div>

            @if (Model.Estado == "Rechazado")
            {
                <div class="col-md-12">
                    <div class="alert alert-danger mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Motivo del rechazo:</strong>
                        @(string.IsNullOrWhiteSpace(Model.MotivoRechazo) ? "—" : Model.MotivoRechazo)
                    </div>
                    @if (!esAdmin || esTecnico)
                    {
                        <div class="mt-3">
                            <a asp-controller="Gastos" asp-action="Corregir" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil-square me-1"></i>Corregir gasto
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.Estado == "Pendiente" && esAdmin)
        {
            <hr class="my-4" />
            <div class="d-flex flex-wrap justify-content-end gap-2">
                <form asp-controller="@volverController" asp-action="Aprobar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Aprobar gasto
                    </button>
                </form>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalRechazarDetalle">
                    <i class="bi bi-x-lg me-1"></i>Rechazar gasto
                </button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">Comprobante</h5>

        @if (!tieneComprobante)
        {
            <p class="text-muted mb-0">
                <i class="bi bi-file-earmark-x me-1 text-danger"></i>Este gasto no tiene comprobante adjunto.
            </p>
        }
        else
        {
            if (esPdf)
            {
                <iframe src="@Model.ComprobanteRuta" class="w-100 border rounded mb-3" style="height: 600px;" title="Comprobante del gasto"></iframe>
            }
            else
            {
                <img src="@Model.ComprobanteRuta" alt="Comprobante del gasto" class="img-fluid border rounded mb-3" style="max-height: 600px;" />
            }
            <div>
                <a href="@Model.ComprobanteRuta" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Abrir en otra pestaña
                </a>
            </div>
        }
    </div>
</div>

@if (Model.Estado == "Pendiente" && esAdmin)
{
    <div class="modal fade" id="modalRechazarDetalle" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-start">
                <form class="js-form-rechazar-gasto" asp-controller="@volverController" asp-action="Rechazar" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fs-6"><i class="bi bi-exclamation-triangle-fill me-2"></i>Motivo de Rechazo</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <label class="form-label fw-bold text-dark">Escriba la justificación:</label>
                        <textarea name="motivoRechazo" class="form-control" rows="3" maxlength="500" placeholder="Ej: La foto del comprobante no es legible..."></textarea>
                        <span class="text-danger small" data-valmsg-for="motivoRechazo"></span>
                    </div>

                    <div class="modal-footer bg-light d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-check-circle-fill me-1"></i>Confirmar Rechazo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/gastos-form.js" asp-append-version="true"></script>
}
