@model IEnumerable<MultiserviciosPiscinas.Models.GastoOperativo>

@{
    ViewData["Title"] = "Gestión de Gastos";

    bool esAdmin = User.Identity?.Name != null && User.Identity.Name.StartsWith("admin", StringComparison.OrdinalIgnoreCase);
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="a-title">Gestión de Gastos (Viáticos / Materiales)</h2>
    <a asp-action="Registrar" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Registrar Nuevo Gasto
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="o-form-card">
    <div class="table-responsive">
        <table id="tablaGastos" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th class="a-text-muted small text-uppercase">Fecha</th>
                    <th class="a-text-muted small text-uppercase">Categoría</th>
                    <th class="a-text-muted small text-uppercase">Monto</th>
                    <th class="a-text-muted small text-uppercase">Descripción</th>
                    <th class="a-text-muted small text-uppercase">Comprobante</th>
                    <th class="a-text-muted small text-uppercase">Estado</th>
                    <th class="a-text-muted small text-uppercase">Motivo Rechazo</th>
                    <th class="a-text-muted small text-uppercase text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>@g.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@(g.Categoria?.NombreCategoria ?? "General")</td>
                        <td><strong>₡@g.Monto.ToString("N2")</strong></td>
                        <td>@(g.Descripcion ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(g.ComprobanteRuta))
                            {
                                <span class="small">
                                    <i class="bi bi-file-check me-1 text-success"></i>Comprobante adjunto
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-file-earmark-x me-1 text-danger"></i>Sin comprobante
                                </span>
                            }
                        </td>
                        <td>
                            @if (g.Estado == "Aprobado")
                            {
                                <span class="c-badge c-badge-green">Aprobado</span>
                            }
                            else if (g.Estado == "Pendiente")
                            {
                                <span class="c-badge c-badge-amber">Pendiente</span>
                            }
                            else
                            {
                                <span class="c-badge c-badge-red">Rechazado</span>
                            }
                        </td>
                        <td>
                            @if (g.Estado == "Rechazado")
                            {
                                <span class="text-danger small fw-bold"><i class="bi bi-exclamation-circle me-1"></i>@g.MotivoRechazo</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (!string.IsNullOrEmpty(g.ComprobanteRuta))
                                    {
                                        <li>
                                            <a href="@g.ComprobanteRuta" target="_blank" class="dropdown-item">
                                                <i class="bi bi-eye me-2 text-info"></i>Ver
                                            </a>
                                        </li>
                                    }
                                    @if (g.Estado == "Pendiente")
                                    {
                                        if (esAdmin)
                                        {
                                            <li>
                                                <form asp-action="Aprobar" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@g.Id" />
                                                    <button type="submit" class="dropdown-item text-success" title="Aprobar">
                                                        <i class="bi bi-check-lg me-2 text-success"></i>Aprobar
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#modalRechazar-@g.Id" title="Rechazar">
                                                    <i class="bi bi-x-lg me-2 text-danger"></i>Rechazar
                                                </button>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <span class="dropdown-item disabled text-muted">
                                                    <i class="bi bi-clock me-2 text-secondary"></i>En espera
                                                </span>
                                            </li>
                                        }
                                    }
                                    else if (g.Estado == "Rechazado" && !esAdmin)
                                    {
                                        <li>
                                            <a asp-action="Corregir" asp-route-id="@g.Id" class="dropdown-item">
                                                <i class="bi bi-pencil me-2 text-warning"></i>Corregir
                                            </a>
                                        </li>
                                    }
                                    @if (string.IsNullOrEmpty(g.ComprobanteRuta) && (g.Estado == "Aprobado" || (g.Estado == "Rechazado" && esAdmin)))
                                    {
                                        <li>
                                            <span class="dropdown-item disabled text-muted">
                                                <i class="bi bi-dash-circle me-2 text-secondary"></i>Sin acciones
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Sección de modales *@
@if (Model != null && Model.Any())
{
    @foreach (var g in Model)
    {
        @if (g.Estado == "Pendiente")
        {
            <div class="modal fade" id="modalRechazar-@g.Id" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-start">
                        <form asp-action="Rechazar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@g.Id" />

                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title fs-6"><i class="bi bi-exclamation-triangle-fill me-2"></i>Motivo de Rechazo</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <label class="form-label fw-bold text-dark">Escriba la justificación:</label>
                                <textarea name="motivoRechazo" class="form-control" rows="3" required placeholder="Ej: La foto del comprobante no es legible..."></textarea>
                            </div>

                            <div class="modal-footer bg-light d-flex justify-content-end">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i>Cancelar
                                </button>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-check-circle-fill me-1"></i>Confirmar Rechazo
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}

@section Scripts {
    <script src="~/js/gastos-tabla.js"></script>
}