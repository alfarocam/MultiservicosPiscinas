@model MultiserviciosPiscinas.DTOs.ReporteGastosOperativosDto
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="c-page-header">
    <h2><i class="bi bi-pie-chart me-2"></i>Resumen de Gastos Operativos</h2>
</div>

<!-- Formulario de filtros -->
<div class="c-data-card mb-3" style="padding:20px 24px">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em">Fecha desde</label>
            <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em">Fecha hasta</label>
            <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em">Categoría</label>
            <select name="categoriaId" class="form-control">
                <option value="">Todas</option>
                @if (ViewBag.Categorias != null)
                {
                    @foreach (var categoria in ViewBag.Categorias)
                    {
                        if (ViewBag.CategoriaId == categoria.Id)
                        {
                            <option value="@categoria.Id" selected>@categoria.NombreCategoria</option>
                        }
                        else
                        {
                            <option value="@categoria.Id">@categoria.NombreCategoria</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn w-100">Ver Resumen</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </form>
</div>

<!-- Mensaje si no hay datos -->
@if (Model.Detalle.Count == 0)
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        No hay gastos para el período seleccionado.
    </div>
}
else
{
    <!-- Totales por categoría -->
    <div class="c-data-card mb-3">
        <div style="background-color:var(--color-navbar-bg);padding:14px 20px;display:flex;align-items:center;gap:8px">
            <i class="bi bi-bar-chart text-white"></i>
            <span class="fw-bold text-white" style="font-family:var(--font-family-heading)">Totales por Categoría</span>
        </div>
        <table class="c-data-table">
            <thead>
                <tr>
                    <th>Categoría</th>
                    <th>Total</th>
                    <th>Cantidad</th>
                    <th>Porcentaje (%)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categoria in Model.TotalesPorCategoria)
                {
                    <tr>
                        <td class="fw-semibold">@categoria.NombreCategoria</td>
                        <td><span class="fw-bold" style="color:var(--color-btn-bg)">₡@categoria.Total.ToString("N2")</span></td>
                        <td>@categoria.Cantidad</td>
                        <td>@categoria.Porcentaje.ToString("F2")%</td>
                    </tr>
                }
                <tr style="background-color:#f8f9fa;font-weight:bold">
                    <td>TOTAL GENERAL</td>
                    <td style="color:var(--color-btn-bg)">₡@Model.TotalGeneral.ToString("N2")</td>
                    <td>@Model.Detalle.Count()</td>
                    <td>100.00%</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Gráfico de distribución -->
    <div class="c-data-card mb-3">
        <div style="background-color:var(--color-navbar-bg);padding:14px 20px;display:flex;align-items:center;gap:8px">
            <i class="bi bi-pie-chart text-white"></i>
            <span class="fw-bold text-white" style="font-family:var(--font-family-heading)">Distribución de Gastos</span>
        </div>
        <div style="padding:20px;display:flex;justify-content:center;align-items:center">
            <canvas id="graficoDistribucion" style="max-width:400px;max-height:400px"></canvas>
        </div>
    </div>

    <!-- Listado detallado -->
    <div class="c-data-card mb-3">
        <div style="background-color:var(--color-navbar-bg);padding:14px 20px;display:flex;align-items:center;gap:8px;justify-content:space-between">
            <div style="display:flex;align-items:center;gap:8px">
                <i class="bi bi-list-ul text-white"></i>
                <span class="fw-bold text-white" style="font-family:var(--font-family-heading)">Detalle de Gastos</span>
            </div>
            <!-- Botón exportar con parámetros actuales -->
            <a asp-action="ExportarExcel"
               asp-route-fechaDesde="@ViewBag.FechaDesde"
               asp-route-fechaHasta="@ViewBag.FechaHasta"
               asp-route-categoriaId="@(ViewBag.CategoriaId ?? "")"
               class="btn btn-sm btn-success">
                <i class="bi bi-download me-1"></i>Exportar Reporte de Gastos
            </a>
        </div>
        <table class="c-data-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gasto in Model.Detalle)
                {
                    <tr>
                        <td>@gasto.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@gasto.NombreCategoria</td>
                        <td>@(gasto.Descripcion ?? "-")</td>
                        <td><span class="fw-bold" style="color:var(--color-btn-bg)">₡@gasto.Monto.ToString("N2")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Datos del gráfico en JSON (camelCase para que coincida con el JS) -->
    <script type="application/json" id="datosGrafico">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TotalesPorCategoria, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
    </script>

    <script src="~/js/reporteGastosOperativos.js"></script>
}
