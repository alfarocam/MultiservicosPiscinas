@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Nueva cotización";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Nueva cotización</h2>
    <button type="button" class="btn btn-info" id="btnAbrirCarrito" data-bs-toggle="modal" data-bs-target="#modalCarrito">
        <i class="bi bi-cart"></i> Carrito <span class="badge bg-danger" id="badgeCarrito" style="display:none;">0</span>
    </button>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Buscar productos o servicios</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <select id="categoriaProducto" class="form-select">
                        <option value="">Selecciona una categoría...</option>
                    </select>
                </div>

                <div id="productosGrid" class="row g-3">
                    <p class="text-muted">Selecciona una categoría para ver los productos disponibles.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Información del cliente</h5>
            </div>
            <div class="card-body">
                <form id="formCliente" method="post" action="@Url.Action("GenerarCotizacion")">
                    @Html.AntiForgeryToken()

                    <div class="mb-3 position-relative">
                        <label class="form-label">Buscar cliente existente</label>
                        <input type="text" id="busquedaCliente" class="form-control" placeholder="Nombre, correo o teléfono..." autocomplete="off" />
                        <div id="resultadosClientes" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000; display:none; max-height: 220px; overflow-y: auto;"></div>
                        <small class="text-muted">Escribe para buscar, o completa los campos si es un cliente nuevo</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre completo *</label>
                        <input type="text" id="nombreCliente" name="NombreCliente" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo *</label>
                        <input type="email" id="correoCliente" name="CorreoCliente" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teléfono *</label>
                        <input type="tel" id="telefonoCliente" name="TelefonoCliente" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100" id="btnGenerarCotizacion">
                        <i class="bi bi-file-pdf"></i> Generar Cotización (PDF)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Carrito -->
<div class="modal fade" id="modalCarrito" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Carrito de cotización</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="contenidoCarrito" style="min-height: 200px;">
                    <p class="text-muted">Cargando carrito...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cotizacion.js"></script>
}
