@model List<MultiserviciosPiscinas.DTOs.Cotizacion.CotizacionAdminListadoDto>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Cotizaciones";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Cotizaciones</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nueva cotización
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    var tipoAlert = TempData["TipoMensaje"]?.ToString() ?? "success";

    <div class="alert alert-@tipoAlert alert-dismissible fade show mb-3" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["CotizacionDescargarId"] != null)
{
    <a id="linkDescargaAutoCotizacion" href="@Url.Action("DescargarPdf", "Cotizacion", new { id = TempData["CotizacionDescargarId"] })" class="d-none"></a>
}

<div class="o-form-card">
    <div class="table-responsive">
        <table id="tablaCotizaciones" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th>N° Cotización</th>
                    <th>Cliente</th>
                    <th>Emisión</th>
                    <th>Vigencia</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Factura</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cot in Model)
                {
                    var badgeEstado = cot.Estado switch
                    {
                        "Aceptada" => "c-badge-green",
                        "Enviada" or "Pendiente" => "c-badge-amber",
                        "Rechazada" => "c-badge-red",
                        _ => "c-badge-gray"
                    };

                    <tr>
                        <td><strong>@cot.NumeroCotizacion</strong></td>
                        <td>
                            <div>@cot.NombreCliente</div>
                            <small class="text-muted">@cot.CorreoCliente</small>
                        </td>
                        <td data-order="@cot.FechaEmision.ToString("yyyyMMdd")">@cot.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td data-order="@cot.FechaVigencia.ToString("yyyyMMdd")">@cot.FechaVigencia.ToString("dd/MM/yyyy")</td>
                        <td class="c-price"><strong>₡@cot.Total.ToString("N2")</strong></td>
                        <td><span class="c-badge @badgeEstado">@cot.Estado</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(cot.NumeroFactura))
                            {
                                <span class="c-badge c-badge-blue">@cot.NumeroFactura</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Detalle" asp-route-id="@cot.Id" class="dropdown-item">
                                            <i class="bi bi-eye me-2 text-info"></i>Ver detalle
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="DescargarPdf" asp-route-id="@cot.Id" class="dropdown-item">
                                            <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>Descargar PDF
                                        </a>
                                    </li>
                                    @if (cot.Estado == "Enviada" && cot.FacturaId == null)
                                    {
                                        <li>
                                            <form class="js-cambiar-estado-cotizacion d-inline"
                                                  asp-action="CambiarEstado"
                                                  method="post"
                                                  data-accion="aceptar"
                                                  data-numero="@cot.NumeroCotizacion">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@cot.Id" />
                                                <input type="hidden" name="nuevoEstado" value="Aceptada" />
                                                <button type="submit" class="dropdown-item text-success">
                                                    <i class="bi bi-check-lg me-2 text-success"></i>Aceptar
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form class="js-cambiar-estado-cotizacion d-inline"
                                                  asp-action="CambiarEstado"
                                                  method="post"
                                                  data-accion="rechazar"
                                                  data-numero="@cot.NumeroCotizacion">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@cot.Id" />
                                                <input type="hidden" name="nuevoEstado" value="Rechazada" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-x-lg me-2 text-danger"></i>Rechazar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    @if (cot.FacturaId.HasValue)
                                    {
                                        <li>
                                            <a asp-controller="Facturacion" asp-action="DetalleAdmin" asp-route-id="@cot.FacturaId.Value" class="dropdown-item">
                                                <i class="bi bi-receipt me-2 text-primary"></i>Ver factura
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/cotizacion-tabla.js" asp-append-version="true"></script>
}
