@model List<MultiserviciosPiscinas.DTOs.Factura.CotizacionListadoDto>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Cotizaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Cotizaciones disponibles para facturar</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva cotización
    </a>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        No hay cotizaciones disponibles para facturar en este momento.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cot in Model)
                    {
                        <tr>
                            <td><strong>@cot.NumeroCotizacion</strong></td>
                            <td>@cot.NombreCliente</td>
                            <td>@cot.FechaEmision.ToString("dd/MM/yyyy")</td>
                            <td><strong>₡@cot.Total.ToString("N2")</strong></td>
                            <td><span class="badge bg-warning text-dark">@cot.Estado</span></td>
                            <td class="text-center">
                                <a asp-action="Facturar" asp-route-id="@cot.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-receipt"></i> Facturar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
