@model MultiserviciosPiscinas.Models.AnuncioEditarViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Editar comunicado";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-megaphone-fill me-2"></i>Editar comunicado</h2>
    <a asp-action="Index" class="btn btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-semibold"></label>
                <input asp-for="Titulo" class="form-control" required />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contenido" class="form-label fw-semibold"></label>
                <textarea asp-for="Contenido" class="form-control" rows="5" required></textarea>
                <span asp-validation-for="Contenido" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Urgente" class="form-check-input" type="checkbox" />
                <label asp-for="Urgente" class="form-check-label fw-semibold">
                    Marcar como urgente
                </label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar">
                    <i class="bi bi-trash me-1"></i>Eliminar
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill me-1"></i>Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar comunicado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que querés eliminar este comunicado? Esta acción <strong>no se puede deshacer</strong> y desaparecerá del tablón para todos los empleados.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Sí, eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>