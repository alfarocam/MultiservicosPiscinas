@model MultiserviciosPiscinas.Models.AnuncioCreateViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Publicar comunicado";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Publicar comunicado</h2>
    <a asp-action="Index" class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-megaphone me-2"></i>Información del comunicado
            </h5>
            <hr class="c-hr-accent" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-semibold"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej. Cambio de horario de ruta" required />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contenido" class="form-label fw-semibold"></label>
                <textarea asp-for="Contenido" class="form-control" rows="5" placeholder="Escriba aquí el detalle del comunicado..." required></textarea>
                <span asp-validation-for="Contenido" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Urgente" class="form-check-input" type="checkbox" />
                <label asp-for="Urgente" class="form-check-label fw-semibold">
                    Marcar como urgente
                </label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill me-1"></i>Publicar
                </button>
            </div>
        </form>
    </div>
</div>
