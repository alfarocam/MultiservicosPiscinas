@model MultiserviciosPiscinas.Models.AnuncioCreateViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Publicar comunicado";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-megaphone-fill me-2"></i>Publicar comunicado</h2>
    <a asp-action="Index" class="btn btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-semibold"></label>
                <input asp-for="Titulo" class="form-control" required />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contenido" class="form-label fw-semibold"></label>
                <textarea asp-for="Contenido" class="form-control" rows="5" required></textarea>
                <span asp-validation-for="Contenido" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Urgente" class="form-check-input" type="checkbox" />
                <label asp-for="Urgente" class="form-check-label fw-semibold">
                    Marcar como urgente
                </label>
            </div>

            <button type="submit" class="btn">
                <i class="bi bi-check-circle-fill me-1"></i> Publicar
            </button>
        </form>
    </div>
</div>