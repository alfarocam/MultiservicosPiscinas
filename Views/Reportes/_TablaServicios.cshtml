@model MultiserviciosPiscinas.Models.ReporteServiciosViewModel

@if (Model.Servicios.Count == 0)
{
    <p class="text-muted text-center py-4">No se encontraron servicios para los filtros seleccionados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th>Técnico</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Servicios)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Cliente</td>
                        <td>@item.TipoServicio</td>
                        <td>@item.Tecnico</td>
                        <td>
                            @{
                                var badgeClass = item.Estado switch {
                                    "Completado" or "Finalizado" => "c-badge-green",
                                    "En progreso" => "c-badge-blue",
                                    "Pendiente" => "c-badge-amber",
                                    "Cancelado" => "c-badge-red",
                                    _ => "c-badge-gray"
                                };
                            }
                            <span class="c-badge @badgeClass">@item.Estado</span>
                        </td>
                        <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
