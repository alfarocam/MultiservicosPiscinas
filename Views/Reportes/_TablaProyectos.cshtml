@model MultiserviciosPiscinas.Models.ReporteProyectosViewModel

@if (Model.Proyectos.Count == 0)
{
    <p class="text-muted text-center py-4">No se encontraron proyectos para los filtros seleccionados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Inicio</th>
                    <th>Fin Estimado</th>
                    <th>Presupuesto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Proyectos)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Cliente</td>
                        <td>
                            @{
                                var badgeClass = item.Estado switch {
                                    "Finalizado" => "bg-success",
                                    "En Curso" => "bg-primary",
                                    "Planificación" => "bg-info",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@item.Estado</span>
                        </td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@(item.FechaFinEstimada?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td>@item.Presupuesto.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
