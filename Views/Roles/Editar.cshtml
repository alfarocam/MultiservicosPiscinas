@model MultiserviciosPiscinas.Models.Usuario

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Editar Usuario";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="a-title mb-0">Editar Usuario</h2>
    <a asp-action="Index" class="btn btn-success"><i class="bi bi-arrow-left me-1"></i>Volver</a>
</div>

<div class="o-form-card">
    <form id="formEditarUsuario" asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                    <input asp-for="Nombre" class="form-control" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ApellidoPaterno" class="form-label fw-bold">Apellido Paterno</label>
                    <input asp-for="ApellidoPaterno" class="form-control" required />
                    <span asp-validation-for="ApellidoPaterno" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ApellidoMaterno" class="form-label fw-bold">Apellido Materno</label>
                    <input asp-for="ApellidoMaterno" class="form-control" required />
                    <span asp-validation-for="ApellidoMaterno" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Correo" class="form-label fw-bold">Correo Electrónico</label>
                    <input asp-for="Correo" type="email" class="form-control" required />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label for="rolId" class="form-label fw-bold">Rol</label>
                    <select name="rolId" id="rolId" class="form-select" asp-items="ViewBag.Roles">
                        <option value="">-- Mantener rol actual (@ViewBag.RolActualNombre) --</option>
                    </select>
                    <span asp-validation-for="RolId" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Activo" class="form-label fw-bold">Estado</label>
                    <select asp-for="Activo" class="form-select">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Cancelar</a>
                <button type="submit" class="btn c-btn-sm-primary">
                    <i class="bi bi-floppy me-1"></i>Guardar Cambios
                </button>
            </div>
        </form>
</div>

@section Scripts {
    <script src="~/js/roles-tabla.js" asp-append-version="true"></script>
}
