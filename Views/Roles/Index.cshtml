@model MultiserviciosPiscinas.Models.RolesIndexViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Roles y permisos";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="c-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="a-title mb-0">Usuarios, Roles y Permisos</h2>
    <div class="d-flex gap-2">
        <a asp-action="Asignar" class="btn c-btn-sm-primary"><i class="bi bi-person-workspace me-1"></i>Asignar rol</a>
        <a asp-action="Crear" class="btn c-btn-sm-primary"><i class="bi bi-person-plus me-1"></i>Nuevo Colaborador</a>
    </div>
</div>

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-end flex-wrap w-100">
        <div>
            <label for="filtroFechaModificacion" class="form-label fw-semibold mb-1 small">Filtrar por fecha de modificación</label>
            <input type="date"
                   id="filtroFechaModificacion"
                   name="fechaModificacion"
                   value="@(Model.FechaModificacionFiltro?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-info">
            <i class="bi bi-funnel me-1"></i>Filtrar
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Limpiar
        </a>
    </form>
</div>

<div class="o-form-card mb-4">
    <h5 class="mb-3 fw-bold">Usuarios Registrados</h5>
    <div class="table-responsive">
        <table id="tablaUsuarios" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="a-text-muted small text-uppercase"># ID</th>
                    <th class="a-text-muted small text-uppercase">Nombre Completo</th>
                    <th class="a-text-muted small text-uppercase">Correo</th>
                    <th class="a-text-muted small text-uppercase">Rol</th>
                    <th class="a-text-muted small text-uppercase">Estado</th>
                    <th class="a-text-muted small text-uppercase">Fecha de Creación</th>
                    <th class="a-text-muted small text-uppercase">Fecha de Modificación</th>
                    <th class="a-text-muted small text-uppercase text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    var rolBadgeClass = usuario.RolId switch
                    {
                        1 => "c-badge-blue",
                        2 => "c-badge-teal",
                        _ => "c-badge-gray"
                    };

                    <tr>
                        <td>@usuario.Id</td>
                        <td class="fw-semibold">@usuario.NombreCompleto</td>
                        <td>@usuario.Correo</td>
                        <td><span class="c-badge @rolBadgeClass">@usuario.RolNombre</span></td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <span class="c-badge c-badge-green">Activo</span>
                            }
                            else
                            {
                                <span class="c-badge c-badge-red">Inactivo</span>
                            }
                        </td>
                        <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (usuario.FechaModificacion.HasValue)
                            {
                                @usuario.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted small">Sin modificaciones</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Editar" asp-route-id="@usuario.Id" title="Editar usuario" class="dropdown-item">
                                            <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                        </a>
                                    </li>
                                    @if (usuario.Activo)
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="dropdown-item text-danger btn-inactivar-usuario">
                                                    <i class="bi bi-slash-circle me-2 text-danger"></i>Inactivar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="dropdown-item text-success btn-activar-usuario">
                                                    <i class="bi bi-check-circle me-2 text-success"></i>Activar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="o-form-card">
    <h5 class="mb-3 fw-bold">Resumen de Roles</h5>
    <div class="table-responsive">
        <table id="tablaRoles" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="a-text-muted small text-uppercase"># ID</th>
                    <th class="a-text-muted small text-uppercase">Rol</th>
                    <th class="a-text-muted small text-uppercase">Descripción</th>
                    <th class="a-text-muted small text-uppercase">Usuarios asignados</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model.Roles)
                {
                    <tr>
                        <td>@rol.Id</td>
                        <td><strong>@rol.Nombre</strong></td>
                        <td>@(rol.Descripcion ?? "Sin descripción asignada en este momento.")</td>
                        <td>
                            <span class="badge bg-secondary px-2 py-1">@rol.Usuario.Count usuarios</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/roles-tabla.js" asp-append-version="true"></script>
}
