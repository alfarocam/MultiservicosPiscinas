@model MultiserviciosPiscinas.Models.RolesIndexViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Roles y permisos";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="c-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <h2 class="a-title mb-0">Usuarios, Roles y Permisos</h2>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-action="Asignar" class="btn btn-outline-primary"><i class="bi bi-person-workspace me-1"></i>Asignar rol</a>
        <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Nuevo Colaborador</a>
    </div>
</div>

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-end flex-wrap w-100">
        <div>
            <label for="filtroFechaModificacion" class="form-label fw-semibold mb-1 small">Filtrar por fecha de modificación</label>
            <input type="date"
                   id="filtroFechaModificacion"
                   name="fechaModificacion"
                   value="@(Model.FechaModificacionFiltro?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-info">
            <i class="bi bi-funnel me-1"></i>Filtrar
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Limpiar
        </a>
    </form>
</div>

<div class="o-form-card mb-4">
    <h5 class="mb-3 fw-bold">Usuarios Registrados</h5>
    <div class="table-responsive">
        <table id="tablaUsuarios" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="a-text-muted small text-uppercase"># ID</th>
                    <th class="a-text-muted small text-uppercase">Nombre Completo</th>
                    <th class="a-text-muted small text-uppercase">Correo</th>
                    <th class="a-text-muted small text-uppercase">Rol</th>
                    <th class="a-text-muted small text-uppercase">Estado</th>
                    <th class="a-text-muted small text-uppercase">Fecha de Creación</th>
                    <th class="a-text-muted small text-uppercase">Fecha de Modificación</th>
                    <th class="a-text-muted small text-uppercase text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    var rolBadgeClass = usuario.RolId switch
                    {
                        1 => "c-badge-blue",
                        2 => "c-badge-teal",
                        _ => "c-badge-gray"
                    };

                    <tr>
                        <td>@usuario.Id</td>
                        <td class="fw-semibold">@usuario.NombreCompleto</td>
                        <td>@usuario.Correo</td>
                        <td><span class="c-badge @rolBadgeClass">@usuario.RolNombre</span></td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <span class="c-badge c-badge-green">Activo</span>
                            }
                            else
                            {
                                <span class="c-badge c-badge-red">Inactivo</span>
                            }
                        </td>
                        <td data-order="@usuario.FechaCreacion.ToString("yyyyMMddHHmmss")">@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-order="@(usuario.FechaModificacion.HasValue ? usuario.FechaModificacion.Value.ToString("yyyyMMddHHmmss") : "0")">
                            @if (usuario.FechaModificacion.HasValue)
                            {
                                @usuario.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted small">Sin modificaciones</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Editar" asp-route-id="@usuario.Id" title="Editar usuario" class="dropdown-item">
                                            <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                        </a>
                                    </li>
                                    @if (usuario.Activo)
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="dropdown-item text-danger btn-inactivar-usuario">
                                                    <i class="bi bi-slash-circle me-2 text-danger"></i>Inactivar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="dropdown-item text-success btn-activar-usuario">
                                                    <i class="bi bi-check-circle me-2 text-success"></i>Activar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="o-form-card mb-4">
    <h5 class="mb-3 fw-bold">Resumen de Roles</h5>
    <div class="table-responsive">
        <table id="tablaRoles" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="a-text-muted small text-uppercase"># ID</th>
                    <th class="a-text-muted small text-uppercase">Rol</th>
                    <th class="a-text-muted small text-uppercase">Descripción</th>
                    <th class="a-text-muted small text-uppercase">Usuarios asignados</th>
                    <th class="a-text-muted small text-uppercase text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rol in Model.Roles)
                {
                    <tr>
                        <td>@rol.Id</td>
                        <td><strong>@rol.Nombre</strong></td>
                        <td>@(rol.Descripcion ?? "Sin descripción asignada en este momento.")</td>
                        <td>
                            <span class="badge bg-secondary px-2 py-1">@rol.Usuario.Count usuarios</span>
                        </td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-outline-warning"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEditarRol-@rol.Id">
                                <i class="bi bi-pencil me-1"></i>Editar descripción
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="o-form-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h5 class="mb-1 fw-bold">Matriz de Permisos por Rol (Módulo y Acción)</h5>
            <p class="text-muted small mb-0">Consulte y administre los permisos habilitados para cada perfil del sistema.</p>
        </div>
    </div>

    <form asp-action="GuardarMatrizPermisos" method="post">
        @Html.AntiForgeryToken()
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="a-text-muted small text-uppercase">Módulo</th>
                        <th class="a-text-muted small text-uppercase">Acción / Alcance</th>
                        <th class="a-text-muted small text-uppercase text-center">Administrador</th>
                        <th class="a-text-muted small text-uppercase text-center">Técnico</th>
                        <th class="a-text-muted small text-uppercase text-center">Cliente</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var permiso in Model.MatrizPermisos)
                    {
                        <tr>
                            <td class="fw-semibold">@permiso.Modulo</td>
                            <td>@permiso.Accion</td>
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" checked="@permiso.Admin" disabled title="El administrador conserva los permisos administrativos del sistema" />
                            </td>
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" name="permisosTecnico" value="@permiso.Clave" checked="@permiso.Tecnico" />
                            </td>
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" name="permisosCliente" value="@permiso.Clave" checked="@permiso.Cliente" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-shield-check me-1"></i>Guardar permisos
            </button>
        </div>
    </form>
</div>

@foreach (var rol in Model.Roles)
{
    <div class="modal fade" id="modalEditarRol-@rol.Id" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-start">
                <form asp-action="EditarRol" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@rol.Id" />

                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fs-6"><i class="bi bi-shield-lock me-2"></i>Editar descripción: @rol.Nombre</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <label for="descRol-@rol.Id" class="form-label fw-bold text-dark">Descripción del rol:</label>
                        <textarea id="descRol-@rol.Id" name="descripcion" class="form-control" rows="3" maxlength="255" required>@rol.Descripcion</textarea>
                    </div>

                    <div class="modal-footer bg-light d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle-fill me-1"></i>Guardar descripción
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/roles-tabla.js" asp-append-version="true"></script>
}
