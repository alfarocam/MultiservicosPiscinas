@model IEnumerable<MultiserviciosPiscinas.Models.Rol>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Roles y permisos";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Roles y permisos</h2>
    <div>
        <a asp-action="Asignar" class="btn btn-primary me-1"><i class="bi bi-person-workspace me-1"></i>Asignar rol</a>
        <a asp-action="Crear" class="btn btn-primary ms-1"><i class="bi bi-person-plus me-1"></i>Nuevo Colaborador</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaRoles" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th># ID</th>
                        <th>Rol</th>
                        <th>Descripción</th>
                        <th>Usuarios asignados</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in Model)
                    {
                        <tr>
                            <td>@rol.Id</td>
                            <td><strong>@rol.Nombre</strong></td>
                            <td>@(rol.Descripcion ?? "Sin descripción asignada en este momento.")</td>
                            <td>
                                <span class="badge bg-secondary px-2 py-1">@rol.Usuario.Count usuarios</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/roles-tabla.js" asp-append-version="true"></script>
}
