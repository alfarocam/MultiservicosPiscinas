@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Modificar Rol";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Modificar Rol de Usuario</h2>
    <a asp-action="Index" class="btn btn-success"><i class="bi bi-arrow-left me-1"></i>Volver</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Asignar" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Seleccione el Usuario</label>
                    <select name="usuarioId" class="form-select" asp-items="ViewBag.Usuarios" required>
                        <option value="" disabled selected>-- Seleccionar por Correo --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Seleccione el Nuevo Rol</label>
                    <select name="rolId" class="form-select" asp-items="ViewBag.Roles" required>
                        <option value="" disabled selected>-- Asignar nuevo rol --</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-1"></i>Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>