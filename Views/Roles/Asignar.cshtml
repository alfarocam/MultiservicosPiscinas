@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Modificar Rol";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Modificar Rol de Usuario (HU-1.6)</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Asignar" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Seleccione el Usuario</label>
                    <select name="usuarioId" id="usuarioSelect" class="form-select" required>
                        <option value="" disabled selected>-- Seleccionar por Correo --</option>
                        @foreach (var usuario in (IEnumerable<MultiserviciosPiscinas.Models.Usuario>)ViewBag.Usuarios)
                        {
                            <option value="@usuario.Id" data-rolid="@usuario.RolId">@usuario.Correo</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Seleccione el Nuevo Rol</label>
                    <select name="rolId" id="rolSelect" class="form-select" required>
                        <option value="" disabled selected>-- Asignar nuevo rol --</option>
                        @foreach (var rol in (IEnumerable<MultiserviciosPiscinas.Models.Rol>)ViewBag.Roles)
                        {
                            <option value="@rol.Id" data-rol-option="@rol.Id">@rol.Nombre</option>
                        }
                    </select>
                    <small class="text-muted">El rol actual del usuario seleccionado no aparecerá en esta lista.</small>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar Cambios de Rol</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/roles-asignar.js" asp-append-version="true"></script>
}