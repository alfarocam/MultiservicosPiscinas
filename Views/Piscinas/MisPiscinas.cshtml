@model List<MultiserviciosPiscinas.Models.PiscinaClienteListViewModel>

@{
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Mis Piscinas";
}

<div class="container my-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="a-title mb-1">
                <i class="bi bi-water me-1"></i>Mis Piscinas
            </h1>
            <p class="a-text-muted mb-0">
                Consulta el estado actual de tus piscinas y sus próximas visitas programadas.
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="o-form-card text-center py-5">
            <i class="bi bi-water c-empty-state-icon"></i>

            <h4 class="mt-3 mb-2">
                No tienes piscinas registradas
            </h4>

            <p class="a-text-muted mb-4">
                Actualmente no hay piscinas asociadas a tu cuenta.
                Puedes contactar al equipo de soporte para solicitar el registro de una piscina.
            </p>

            <a asp-controller="Contacto"
               asp-action="Index"
               class="a-btn text-decoration-none">
                Contactar soporte
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var piscina in Model)
            {
                var badgeClass = piscina.Estado switch
                {
                    "Activa" => "c-badge-green",
                    "Inactiva" => "c-badge-gray",
                    "En mantenimiento" => "c-badge-amber",
                    "En construcción" => "c-badge-blue",
                    _ => "c-badge-gray"
                };

                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm border-0">

                        <img src="@piscina.FotoUrl"
                             alt="Foto de piscina"
                             class="card-img-top c-pool-card-thumb"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                        <div class="d-none align-items-center justify-content-center c-pool-card-placeholder">
                            <i class="bi bi-water c-empty-state-icon"></i>
                        </div>

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1">
                                        Piscina #@piscina.PiscinaId
                                    </h5>
                                    <p class="a-text-muted small mb-0">
                                        @piscina.Tipo
                                    </p>
                                </div>

                                <span class="c-badge @badgeClass">
                                    @piscina.Estado
                                </span>
                            </div>

                            <div class="mb-3">
                                <div class="a-text-muted small mb-1">
                                    <i class="bi bi-droplet-half me-1"></i>Volumen
                                </div>
                                <div>
                                    @piscina.VolumenM3.ToString("0.##") m³
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="a-text-muted small mb-1">
                                    <i class="bi bi-geo-alt-fill me-1"></i>Dirección
                                </div>
                                <div class="small">
                                    @piscina.Direccion
                                </div>
                            </div>

                            <hr class="c-hr-accent" />

                            @if (piscina.ProximaVisitaFechaHora.HasValue)
                            {
                                <div class="c-subcard-item mb-3">
                                    <div class="a-text-muted small mb-1">
                                        <i class="bi bi-calendar-check me-1"></i>Próxima visita
                                    </div>

                                    <div class="fw-semibold">
                                        @piscina.ProximaVisitaFechaHora.Value.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    <div class="a-text-muted small">
                                        @piscina.ProximaVisitaTipo — @piscina.ProximaVisitaEstado
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="c-callout-warning mb-3">
                                    <div class="small text-warning-emphasis">
                                        <i class="bi bi-exclamation-circle me-1"></i>
                                        No hay próximas visitas programadas.
                                    </div>
                                </div>
                            }

                            <a asp-controller="Piscinas"
                               asp-action="DetalleMiPiscina"
                               asp-route-id="@piscina.PiscinaId"
                               class="c-btn-sm c-btn-sm-outline w-100 text-center">
                                Ver detalle
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
