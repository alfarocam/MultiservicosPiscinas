@model IEnumerable<MultiserviciosPiscinas.Models.Piscina>

@{
    ViewData["Title"] = "Piscinas";
}

    <div class="c-page-header d-flex justify-content-between align-items-center">
        <h2 class="a-title">Gestión de Piscinas</h2>
    </div>

    <div class="o-form-card">
        <div class="table-responsive">
            <table id="tablaPiscinas" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th class="a-text-muted small text-uppercase" hidden>ID</th>
                        <th class="a-text-muted small text-uppercase">Cliente</th>
                        <th class="a-text-muted small text-uppercase">Dirección</th>
                        <th class="a-text-muted small text-uppercase">Tipo</th>
                        <th class="a-text-muted small text-uppercase">Volumen (m³)</th>
                        <th class="a-text-muted small text-uppercase">Estado</th>
                        <th class="a-text-muted small text-uppercase text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var piscina in Model)
                    {
                        <tr>
                            <td hidden>@piscina.Id</td>
                            <td>@piscina.Cliente.Usuario.Nombre @piscina.Cliente.Usuario.ApellidoPaterno</td>
                            <td>@piscina.Direccion.Detalles, @piscina.Direccion.Distrito.Nombre</td>
                            <td>@piscina.Tipo</td>
                            <td>@piscina.VolumenM3.ToString("0.##") m³</td>
                            <td>
                                @{
                                    var badgeClass = piscina.Estado switch
                                    {
                                        "Activa"           => "c-badge-green",
                                        "En mantenimiento" => "c-badge-amber",
                                        "En construcción"  => "c-badge-blue",
                                        _                  => "c-badge-gray"
                                    };
                                }
                                <span class="c-badge @badgeClass">
                                    @piscina.Estado
                                </span>
                            </td>
                            <td>
                                <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Detalle" asp-controller="Piscinas" asp-route-id="@piscina.Id" class="dropdown-item">
                                            <i class="bi bi-eye me-2 text-info"></i>Ver
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="Historial" asp-controller="Piscinas" asp-route-id="@piscina.Id" class="dropdown-item">
                                            <i class="bi bi-clock-history me-2 text-primary"></i>Historial
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="Editar" asp-controller="Piscinas" asp-route-id="@piscina.Id" class="dropdown-item">
                                            <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                        </a>
                                    </li>
                            
                                </ul>
                            </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

@section Scripts {
    <script src="~/js/piscinas.js" asp-append-version="true"></script>
}
