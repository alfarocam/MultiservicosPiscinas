@model MultiserviciosPiscinas.Models.Piscina

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Editar Piscina";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">Modificar Piscina #@Model.Id</h2>
        <p class="a-text-light mb-0 small opacity-75">
            Actualice las especificaciones o el estado operativo del registro seleccionado.
        </p>
    </div>
    <a asp-action="Index" asp-controller="Piscinas" class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" asp-controller="Piscinas" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="ClienteId" value="@Model.ClienteId" />

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-pencil-square me-2"></i>Especificaciones de la piscina
            </h5>
            <hr class="c-hr-accent" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cliente</label>
                    <input type="text" class="form-control c-input-disabled" value="@ViewBag.NombreCliente" readonly />
                </div>

                <div class="col-md-6">
                    <label for="DireccionId" class="form-label fw-semibold">Dirección</label>
                    <select id="DireccionId" name="DireccionId" class="form-select"
                            asp-items="@ViewBag.Direcciones" required>
                        <option value="" disabled>Seleccione una dirección...</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="Tipo" class="form-label fw-semibold">Tipo de Piscina</label>
                    <select id="Tipo" name="Tipo" class="form-select"
                            asp-items="@ViewBag.Tipos" required>
                        <option value="" disabled>Seleccione una opción...</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="VolumenM3" class="form-label fw-semibold">Volumen (m³)</label>
                    <input type="number" step="0.01" min="0" id="VolumenM3" name="VolumenM3"
                           class="form-control" value="@Model.VolumenM3" required />
                </div>

                <div class="col-md-4">
                    <label for="Estado" class="form-label fw-semibold">Estado</label>
                    <select id="Estado" name="Estado" class="form-select"
                            asp-items="@ViewBag.Estados" required>
                        <option value="" disabled>Seleccione un estado...</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-2">
                <a asp-action="Index" asp-controller="Piscinas"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Actualizar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
