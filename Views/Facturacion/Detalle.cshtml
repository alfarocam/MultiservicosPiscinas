@model MultiserviciosPiscinas.DTOs.Factura.CompraDetalleViewModel

@{
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Detalle de Compra";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="a-title">Detalle de Compra</h1>
                <a asp-action="MisCompras" class="btn btn-outline-secondary">Volver a Mis Compras</a>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="o-form-card">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Número de Factura:</strong> @Model.NumeroFactura</p>
                        <p><strong>Fecha de Emisión:</strong> @Model.FechaEmision.ToString("dd/MM/yyyy")</p>
                        <p><strong>Fecha de Vencimiento:</strong> @Model.FechaVencimiento.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-6 text-end">
                        <p><strong>Condición de Pago:</strong> @Model.CondicionPago</p>
                        <p><strong>Estado:</strong> <span class="badge bg-success">@Model.Estado</span></p>
                    </div>
                </div>

                <hr />

                <h5 class="mb-3">Artículos Comprados</h5>
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Precio Unit.</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">IVA</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td>
                                    <strong>@linea.Nombre</strong><br/>
                                    <small class="a-text-muted">@linea.Descripcion</small>
                                </td>
                                <td class="text-end">₡@linea.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">@linea.Cantidad</td>
                                <td class="text-end">₡@linea.LineaSubtotal.ToString("N2")</td>
                                <td class="text-end">₡@linea.LineaImpuesto.ToString("N2")</td>
                                <td class="text-end"><strong>₡@linea.LineaTotal.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-4">
            <div class="o-form-card">
                <h5>Resumen de Pago</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal:</span>
                    <span>₡@Model.Subtotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>IVA (13%):</span>
                    <span>₡@Model.ImpuestoTotal.ToString("N2")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-3">
                    <strong>Total:</strong>
                    <strong class="fs-5 text-success">₡@Model.Total.ToString("N2")</strong>
                </div>

                @if (!string.IsNullOrEmpty(Model.ComprobanteSinpeRuta))
                {
                    <hr />
                    <h6>Comprobante de Pago</h6>
                    <img src="@Model.ComprobanteSinpeRuta" alt="Comprobante" class="img-fluid border rounded c-prod-img-lg">
                }
            </div>
        </div>
    </div>
</div>
