@model MultiserviciosPiscinas.DTOs.Factura.FacturaAdminDetalleViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = $"Factura {Model.NumeroFactura}";

    var badgeEstado = Model.Estado switch
    {
        "Pagada" or "Completada" => "c-badge-green",
        "Pendiente" => "c-badge-amber",
        "Anulada" or "Cancelada" => "c-badge-red",
        _ => "c-badge-gray"
    };

    bool tieneComprobante = !string.IsNullOrEmpty(Model.ComprobanteSinpeRuta);
    bool esPdf = tieneComprobante && Model.ComprobanteSinpeRuta!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
}

<div class="c-page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h2 class="mb-0">Detalle de Factura — @Model.NumeroFactura</h2>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="DescargarPdfAdmin" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF
        </a>
        <a asp-action="Index" class="btn btn-success">
            <i class="bi bi-arrow-left me-1"></i>Volver a Facturación
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="o-form-card">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Número de Factura:</strong> @Model.NumeroFactura</p>
                    <p class="mb-1"><strong>Cliente:</strong> @Model.NombreCliente</p>
                    <p class="mb-1"><strong>Correo:</strong> @Model.CorreoCliente</p>
                    <p class="mb-0">
                        <strong>Origen:</strong>
                        @if (!string.IsNullOrEmpty(Model.NumeroCotizacion))
                        {
                            <span class="c-badge c-badge-blue">@Model.NumeroCotizacion</span>
                        }
                        else
                        {
                            <span class="c-badge c-badge-teal">Tienda</span>
                        }
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-1"><strong>Fecha de Emisión:</strong> @Model.FechaEmision.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1"><strong>Fecha de Vencimiento:</strong> @Model.FechaVencimiento.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1"><strong>Condición de Pago:</strong> @Model.CondicionPago</p>
                    <p class="mb-0"><strong>Estado:</strong> <span class="c-badge @badgeEstado">@Model.Estado</span></p>
                </div>
            </div>

            <hr />

            <h5 class="mb-3">Detalle de Productos / Servicios</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Precio Unit.</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">IVA</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td>
                                    <strong>@linea.Nombre</strong>
                                    @if (!string.IsNullOrWhiteSpace(linea.Descripcion))
                                    {
                                        <br />
                                        <small class="a-text-muted">@linea.Descripcion</small>
                                    }
                                </td>
                                <td class="text-end">₡@linea.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">@linea.Cantidad.ToString("N2")</td>
                                <td class="text-end">₡@linea.LineaSubtotal.ToString("N2")</td>
                                <td class="text-end">₡@linea.LineaImpuesto.ToString("N2")</td>
                                <td class="text-end"><strong>₡@linea.LineaTotal.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="o-form-card">
            <h5 class="mb-3">Resumen de Factura</h5>
            <div class="d-flex justify-content-between mb-2">
                <span>Subtotal:</span>
                <span>₡@Model.Subtotal.ToString("N2")</span>
            </div>
            @if (Model.DescuentoTotal > 0)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>Descuento:</span>
                    <span>-₡@Model.DescuentoTotal.ToString("N2")</span>
                </div>
            }
            <div class="d-flex justify-content-between mb-2">
                <span>IVA:</span>
                <span>₡@Model.ImpuestoTotal.ToString("N2")</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between mb-3">
                <strong>Total:</strong>
                <strong class="fs-5 text-success">₡@Model.Total.ToString("N2")</strong>
            </div>

            <hr />
            <h6 class="mb-2">Comprobante de Pago</h6>
            @if (!tieneComprobante)
            {
                <p class="text-muted small mb-0">No hay comprobante adjunto.</p>
            }
            else
            {
                if (esPdf)
                {
                    <iframe src="@Model.ComprobanteSinpeRuta" class="w-100 border rounded mb-2" style="height: 300px;" title="Comprobante de pago"></iframe>
                }
                else
                {
                    <img src="@Model.ComprobanteSinpeRuta" alt="Comprobante de pago" class="img-fluid border rounded mb-2 c-prod-img-lg" />
                }
                <div>
                    <a href="@Model.ComprobanteSinpeRuta" target="_blank" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir en otra pestaña
                    </a>
                </div>
            }
        </div>
    </div>
</div>
