@{
    ViewData["Title"] = "Nombre del módulo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Nombre del módulo</h2>
    <a asp-action="Crear" class="btn btn-primary">+ Nuevo</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaFacturas" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Campo 1</th>
                        <th>Campo 2</th>
                        <th>Campo 3</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No hay registros aún.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/facturacion-tabla.js" asp-append-version="true"></script>
}