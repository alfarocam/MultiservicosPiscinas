<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Multiservicios y Piscinas</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <nav class="navbar navbar-dark px-3 d-flex justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <button id="sidebarToggle"
                    class="btn btn-link text-white p-0 border-0 me-3"
                    type="button"
                    aria-label="Colapsar menú lateral">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     fill="currentColor"
                     class="bi bi-list"
                     viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                          d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                </svg>
            </button>

            <a class="navbar-brand a-logo fw-bold"
               href="@Url.Action("Index", "ServiciosTecnicos")">
                Multiservicios y Piscinas
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            @await Html.PartialAsync("_CampanaNotificaciones")

            <span class="text-white small">
                @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
            </span>

            <form asp-controller="Auth"
                  asp-action="CerrarSesion"
                  method="post"
                  onsubmit="localStorage.removeItem('activeSidebarLink')">
                <button type="submit" class="btn btn-outline-light btn-sm">
                    Salir
                </button>
            </form>
        </div>
    </nav>

    <div class="t-app-container">
        <nav class="t-sidebar d-flex flex-column p-3 text-white">
            <ul class="nav nav-pills flex-column gap-1">

                <li>
                    <a asp-controller="Perfiles"
                       asp-action="Detalle"
                       class="nav-link text-white">
                        <i class="bi bi-person-circle me-2"></i>
                        Mi Perfil
                    </a>
                </li>

                <li><hr class="border-secondary my-1" /></li>

                <li class="px-2 text-secondary" style="font-size:11px">
                    Mis Servicios
                </li>

                <li>
                    <a asp-controller="ServiciosTecnicos"
                       asp-action="Index"
                       class="nav-link text-white">
                        <i class="bi bi-tools me-2"></i>
                        Servicios Asignados
                    </a>
                </li>

                <li>
                    <a asp-controller="ServiciosTecnicos"
                       asp-action="MiAgenda"
                       class="nav-link text-white">
                        <i class="bi bi-calendar-day me-2"></i>
                        Mi Agenda
                    </a>
                </li>

                <li>
                    <a asp-controller="RutaOptimizada"
                       asp-action="MiRutaDelDia"
                       class="nav-link text-white">
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        Rutas del Día
                    </a>
                </li>

                <li><hr class="border-secondary my-1" /></li>

                <li class="px-2 text-secondary" style="font-size:11px">
                    Piscinas
                </li>

                <li>
                    <a asp-controller="Piscinas"
                       asp-action="Index"
                       class="nav-link text-white">
                        <i class="bi bi-water me-2"></i>
                        Registro de Parámetros
                    </a>
                </li>

                <li><hr class="border-secondary my-1" /></li>

                <li class="px-2 text-secondary" style="font-size:11px">
                    Inventario y Gastos
                </li>

                <li>
                    <a asp-controller="Inventario"
                       asp-action="Index"
                       class="nav-link text-white">
                        <i class="bi bi-box-seam me-2"></i>
                        Inventario
                    </a>
                </li>

                <li>
                    <a asp-controller="Gastos"
                       asp-action="Index"
                       class="nav-link text-white">
                        <i class="bi bi-cash-coin me-2"></i>
                        Mis Gastos
                    </a>
                </li>

                <li><hr class="border-secondary my-1" /></li>

                <li class="px-2 text-secondary" style="font-size:11px">
                    Comunicación
                </li>

                <li>
                    <a asp-controller="TablonAnuncios"
                       asp-action="Index"
                       class="nav-link text-white">
                        <i class="bi bi-megaphone-fill me-2"></i>
                        Tablón de anuncios
                    </a>
                </li>

            </ul>
        </nav>

        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>