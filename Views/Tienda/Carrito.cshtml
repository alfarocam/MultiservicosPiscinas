@model List<MultiserviciosPiscinas.DTOs.Cotizacion.ItemCarritoDto>

@{
    ViewData["Title"] = "Mi Carrito";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="container-fluid p-4">
    @if (TempData["Mensaje"] != null)
    {
        var tipoAlert = TempData["TipoMensaje"]?.ToString() ?? "success";

        <div class="alert alert-@tipoAlert alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="a-title">Mi Carrito</h1>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Tu carrito está vacío. <a href="@Url.Action("Index", "Tienda")">Continúa comprando</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="o-form-card">
                    <h5>Productos en el Carrito</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">IVA</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tablaCarrito">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td class="text-end">₡@item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">@item.Cantidad</td>
                                        <td class="text-end">₡@item.LineaSubtotal.ToString("N2")</td>
                                        <td class="text-end">₡@item.LineaImpuesto.ToString("N2")</td>
                                        <td class="text-end"><strong>₡@item.LineaTotal.ToString("N2")</strong></td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-danger" onclick="eliminarDelCarrito(@item.ProductoId)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="o-form-card">
                    <h5>Resumen</h5>
                    <div class="text-end">
                        <p><strong>Subtotal:</strong> <span id="totalSubtotal">₡@Model.Sum(i => i.LineaSubtotal).ToString("N2")</span></p>
                        <p><strong>IVA (13%):</strong> <span id="totalIVA">₡@Model.Sum(i => i.LineaImpuesto).ToString("N2")</span></p>
                        <h5><strong>Total:</strong> <strong id="totalGeneral">₡@Model.Sum(i => i.LineaTotal).ToString("N2")</strong></h5>
                    </div>
                    <a href="@Url.Action("Comprar", "Tienda")" class="btn btn-success w-100">Comprar</a>
                    <a href="@Url.Action("Index", "Tienda")" class="btn btn-outline-secondary w-100 mt-2">Continuar Comprando</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/tienda.js"></script>
}
