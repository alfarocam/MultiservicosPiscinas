@model List<MultiserviciosPiscinas.DTOs.Cotizacion.ItemCarritoDto>

@{
    ViewData["Title"] = "Mi Carrito";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="a-title">Mi Carrito</h1>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Tu carrito está vacío. <a href="@Url.Action("Index", "Tienda")">Continúa comprando</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Precio Unit.</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total Línea</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody id="tablaCarrito">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Nombre</strong><br/>
                                <small class="a-text-muted">@item.Descripcion</small>
                            </td>
                            <td class="text-end">₡@item.PrecioUnitario.ToString("N2")</td>
                            <td class="text-center">@item.Cantidad</td>
                            <td class="text-end">₡@item.LineaSubtotal.ToString("N2")</td>
                            <td class="text-end">₡@item.LineaImpuesto.ToString("N2")</td>
                            <td class="text-end"><strong>₡@item.LineaTotal.ToString("N2")</strong></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-danger" onclick="eliminarDelCarrito(@item.ProductoId)">Quitar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row mt-4">
            <div class="col-md-8"></div>
            <div class="col-md-4">
                <div class="o-form-card">
                    <h5>Resumen</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span id="totalSubtotal">₡@Model.Sum(i => i.LineaSubtotal).ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>IVA (13%):</span>
                        <span id="totalIVA">₡@Model.Sum(i => i.LineaImpuesto).ToString("N2")</span>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <strong id="totalGeneral">₡@Model.Sum(i => i.LineaTotal).ToString("N2")</strong>
                    </div>
                    <a href="@Url.Action("Comprar", "Tienda")" class="btn btn-success w-100">Comprar</a>
                    <a href="@Url.Action("Index", "Tienda")" class="btn btn-outline-secondary w-100 mt-2">Continuar Comprando</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/tienda.js"></script>
}
