@model MultiserviciosPiscinas.Models.CitaCreateViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Programar cita de servicio";
}

<input type="hidden" id="urlPiscinasPorCliente" value="@Url.Action("GetPiscinasPorCliente", "Agenda")" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="a-title mb-0">
        <i class="bi bi-calendar-plus me-2"></i>Programar cita de servicio
    </h2>
    <a asp-action="Index" class="btn btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <h5 class="fw-bold mb-3" style="color: var(--color-btn-bg);">
                <i class="bi bi-person-fill me-2"></i>Cliente y piscina
            </h5>
            <hr style="border-color: var(--color-accent);" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="ClienteId" class="form-label fw-semibold"></label>
                    <select asp-for="ClienteId" id="clienteSelect" class="form-select" required>
                        <option value="">Seleccione un cliente...</option>
                        @foreach (var c in ViewBag.Clientes)
                        {
                            <option value="@c.id">@c.nombre</option>
                        }
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PiscinaId" class="form-label fw-semibold"></label>
                    <select asp-for="PiscinaId" id="piscinaSelect" class="form-select" disabled required>
                        <option value="">Seleccione un cliente primero...</option>
                        @foreach (var p in ViewBag.Piscinas)
                        {
                            <option value="@p.id">@p.texto</option>
                        }
                    </select>
                    <span asp-validation-for="PiscinaId" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold mb-3" style="color: var(--color-btn-bg);">
                <i class="bi bi-tools me-2"></i>Detalle del servicio
            </h5>
            <hr style="border-color: var(--color-accent);" />

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="TecnicoId" class="form-label fw-semibold"></label>
                    <select asp-for="TecnicoId" class="form-select" required>
                        <option value="">Seleccione un técnico...</option>
                        @foreach (var t in ViewBag.Tecnicos)
                        {
                            <option value="@t.id">@t.nombre</option>
                        }
                    </select>
                    <span asp-validation-for="TecnicoId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Fecha" class="form-label fw-semibold"></label>
                    <input asp-for="Fecha" type="date" class="form-control" required />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Hora" class="form-label fw-semibold"></label>
                    <input asp-for="Hora" type="time" class="form-control" required />
                    <span asp-validation-for="Hora" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Tipo" class="form-label fw-semibold"></label>
                    <select asp-for="Tipo" class="form-select" required>
                        <option value="">Seleccione el tipo de servicio...</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="Inspección">Inspección</option>
                        <option value="Reparación">Reparación</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Notas" class="form-label fw-semibold"></label>
                    <textarea asp-for="Notas" class="form-control" rows="3"
                              placeholder="Detalles adicionales para el técnico (opcional)"></textarea>
                    <span asp-validation-for="Notas" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn">
                    <i class="bi bi-check-circle-fill me-1"></i> Guardar cita
                </button>
                <a asp-action="Index" class="btn btn-sm" style="background-color: var(--color-text-muted) !important;">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/agenda-crear.js"></script>
}