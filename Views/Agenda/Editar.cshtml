@model MultiserviciosPiscinas.Models.CitaEditarViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Detalle de la cita";
    var historial = ViewBag.Historial as List<MultiserviciosPiscinas.Models.BitacoraAuditoria>;

    var badgeClass = Model.Estado switch
    {
        "Pendiente" => "c-badge-gray",
        "Confirmada" => "c-badge-blue",
        "En camino" => "c-badge-blue",
        "En progreso" => "c-badge-amber",
        "Completada" => "c-badge-green",
        "Cancelada" => "c-badge-red",
        _ => "c-badge-gray"
    };
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

<div class="c-page-header">
    <h2><i class="bi bi-calendar-event me-2"></i>Cita #@Model.Id</h2>
    <span class="c-badge c-badge-lg @badgeClass">@Model.Estado</span>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tabDetalle">Detalle</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tabHistorial">Historial</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabDetalle">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Cliente</label>
                        <p class="form-control-plaintext">@Model.ClienteNombre</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Piscina</label>
                        <p class="form-control-plaintext">@Model.PiscinaDescripcion</p>
                    </div>
                </div>

                @if (Model.Estado != "Cancelada")
                {
                    <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="TecnicoId" class="form-label fw-semibold"></label>
                                <select asp-for="TecnicoId" class="form-select" required>
                                    @foreach (var t in ViewBag.Tecnicos)
                                    {
                                        <option value="@t.id">@t.nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="TecnicoId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Fecha" class="form-label fw-semibold"></label>
                                <input asp-for="Fecha" type="date" class="form-control" required />
                                <span asp-validation-for="Fecha" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Hora" class="form-label fw-semibold"></label>
                                <input asp-for="Hora" type="time" class="form-control" required />
                                <span asp-validation-for="Hora" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Notas" class="form-label fw-semibold"></label>
                                <textarea asp-for="Notas" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                                <i class="bi bi-x-circle me-1"></i>Cancelar cita
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle-fill me-1"></i>Guardar cambios
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted">Esta cita está cancelada y no se puede modificar.</p>
                    <a asp-action="Index" class="btn btn-sm btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabHistorial">
        <div class="c-data-card">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Usuario responsable</th>
                        <th>Acción</th>
                        <th>Valor anterior</th>
                        <th>Valor nuevo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (historial == null || !historial.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Todavía no hay cambios registrados para esta cita.</td></tr>
                    }
                    else
                    {
                        foreach (var h in historial)
                        {
                            <tr>
                                <td>@h.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@h.Usuario.Nombre @h.Usuario.ApellidoPaterno</td>
                                <td>
    @(h.ValorNuevo.StartsWith("Estado: Cancelada")
        ? "Cita cancelada"
        : h.Accion == "UPDATE" ? "Cita modificada" : h.Accion)
</td>
                                <td>@h.ValorAnterior</td>
                                <td>@h.ValorNuevo</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCancelar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Cancelar cita</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold">Motivo de cancelación</label>
                    <textarea name="motivoCancelacion" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </button>
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>Confirmar cancelación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>