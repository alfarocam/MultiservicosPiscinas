@model List<MultiserviciosPiscinas.Models.Cita>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Agenda";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

<div class="c-page-header">
    <h2><i class="bi bi-calendar3 me-2"></i>Agenda</h2>
    <div class="d-flex gap-2">
        <a asp-controller="RutaOptimizada" asp-action="Index" class="btn">
            <i class="bi bi-signpost-split-fill me-1"></i>Ruta Optimizada
        </a>
        <a asp-action="Crear" class="btn">+ Nueva cita</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaAgenda" class="table table-hover align-middle">
                <thead class="table-light">
            <tr>
                <th>Cliente</th>
                <th>Piscina</th>
                <th>Técnico</th>
                <th>Fecha y hora</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay citas programadas.</td></tr>
            }
            else
            {
                foreach (var cita in Model)
                {
                    var badgeClass = cita.Estado switch
                    {
                        "Pendiente" => "c-badge-gray",
                        "Confirmada" => "c-badge-blue",
                        "En camino" => "c-badge-blue",
                        "En progreso" => "c-badge-amber",
                        "Completada" => "c-badge-green",
                        "Cancelada" => "c-badge-red",
                        _ => "c-badge-gray"
                    };
                    <tr>
                        <td class="fw-semibold">@cita.Piscina.Cliente.Usuario.Nombre @cita.Piscina.Cliente.Usuario.ApellidoPaterno</td>
                        <td>@cita.Piscina.Tipo — @cita.Piscina.VolumenM3 m³</td>
                        <td>@cita.Tecnico.Nombre @cita.Tecnico.ApellidoPaterno</td>
                        <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@cita.Tipo</td>
                        <td><span class="c-badge @badgeClass">@cita.Estado</span></td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@cita.Id" class="c-btn-sm c-btn-sm-primary">
                                <i class="bi bi-pencil me-1"></i>Editar
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/agenda-tabla.js" asp-append-version="true"></script>
}