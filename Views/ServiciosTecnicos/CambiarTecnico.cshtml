@model MultiserviciosPiscinas.Models.CambiarTecnicoServicioViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Cambiar técnico asignado";
}

<div class="c-page-header">
    <h2>
        Cambiar técnico asignado — Servicio #@Model.ServicioId
    </h2>
</div>

<div class="c-detail-card">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- Datos de solo lectura del servicio y la cita -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Cliente</label>
            <p class="form-control-plaintext">@Model.Cliente</p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Piscina</label>
            <p class="form-control-plaintext">@Model.Piscina</p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Estado del servicio</label>
            <p class="form-control-plaintext">@Model.EstadoServicio</p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Técnico actual</label>
            <p class="form-control-plaintext">@Model.TecnicoActual</p>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha y hora de la cita</label>
            <p class="form-control-plaintext">@Model.FechaHoraCita.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    <form asp-action="CambiarTecnico" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ServicioId" />
        <input type="hidden" asp-for="CitaId" />

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="TecnicoId" class="form-label fw-semibold"></label>
                <select asp-for="TecnicoId" asp-items="ViewBag.Tecnicos" class="form-select">
                    <option value="">Seleccione un técnico...</option>
                </select>
                <span asp-validation-for="TecnicoId" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Detalle" asp-route-id="@Model.ServicioId" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i>Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
