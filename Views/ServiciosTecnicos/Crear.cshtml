@model MultiserviciosPiscinas.Models.ServicioCreateViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Nuevo Servicio Técnico";
}

<div class="c-page-header">
    <h2>Nuevo Servicio Técnico</h2>

    <a asp-action="Index" class="btn">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-calendar-event me-2"></i>Cita asociada
            </h5>
            <hr class="c-hr-accent" />

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="CitaId" class="form-label fw-semibold"></label>
                    <select asp-for="CitaId" class="form-select" required>
                        <option value="">Seleccione la cita para la que se abre este servicio...</option>
                        @foreach (var c in ViewBag.Citas)
                        {
                            <option value="@c.id">@c.texto</option>
                        }
                    </select>
                    <span asp-validation-for="CitaId" class="text-danger small"></span>
                    <div class="form-text">
                        Solo se listan citas confirmadas que todavía no tienen un servicio técnico abierto.
                    </div>
                </div>
            </div>

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-clipboard-check me-2"></i>Detalle del trabajo
            </h5>
            <hr class="c-hr-accent" />

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="TrabajoRealizado" class="form-label fw-semibold"></label>
                    <textarea asp-for="TrabajoRealizado" class="form-control" rows="4"
                              placeholder="Describa el trabajo que el técnico va a realizar en esta visita"></textarea>
                    <span asp-validation-for="TrabajoRealizado" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn">
                    <i class="bi bi-check-circle-fill me-1"></i> Guardar servicio
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
