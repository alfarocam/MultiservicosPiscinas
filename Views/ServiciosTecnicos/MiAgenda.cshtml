@model MultiserviciosPiscinas.Models.MiAgendaViewModel

@{
    Layout = "~/Views/Shared/_LayoutTecnico.cshtml";
    ViewData["Title"] = "Mi Agenda";
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="c-page-header">
    <h2>
        <i class="bi bi-calendar-day me-2"></i>
        Mi Agenda
    </h2>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Servicios Asignados
    </a>
</div>

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="MiAgenda" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <label class="fw-semibold mb-0">Fecha:</label>

        <input type="date"
               name="fecha"
               value="@Model.FechaConsulta.ToString("yyyy-MM-dd")"
               class="form-control c-filter-input-sm" />

        <button type="submit" class="btn">
            <i class="bi bi-search me-1"></i>Consultar
        </button>

        <a asp-action="MiAgenda" class="btn btn-outline-secondary">
            Hoy
        </a>
    </form>
</div>

<div class="c-detail-card mb-3">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="c-detail-field c-field-blue">
                <label>Fecha consultada</label>
                <p>@Model.FechaConsulta.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field c-field-amber">
                <label>Total de citas</label>
                <p>@Model.Citas.Count</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field">
                <label>Estado</label>
                <p>@(Model.Citas.Any() ? "Agenda con visitas" : "Agenda vacía")</p>
            </div>
        </div>
    </div>
</div>

<div class="c-data-card">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Hora</th>
                <th>Cliente</th>
                <th>Tipo de servicio</th>
                <th>Piscina</th>
                <th>Dirección</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Citas.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No hay citas programadas para el día consultado.
                    </td>
                </tr>
            }
            else
            {
                foreach (var cita in Model.Citas)
                {
                    var badgeClass = cita.Estado switch
                    {
                        "Pendiente" => "c-badge-gray",
                        "Confirmada" => "c-badge-blue",
                        "En camino" => "c-badge-amber",
                        "En progreso" => "c-badge-amber",
                        "Completada" => "c-badge-green",
                        "Cancelada" => "c-badge-red",
                        _ => "c-badge-gray"
                    };

                    <tr>
                        <td class="fw-bold">
                            @cita.FechaHora.ToString("HH:mm")
                        </td>

                        <td class="fw-semibold">
                            @cita.Cliente
                        </td>

                        <td>
                            @cita.TipoServicio
                        </td>

                        <td>
                            @cita.Piscina
                        </td>

                        <td class="c-table-col-md">
                            @cita.Direccion
                        </td>

                        <td>
                            <span class="c-badge @badgeClass">
                                @cita.Estado
                            </span>
                        </td>

                        <td>
                            <div class="d-flex justify-content-center gap-1 flex-wrap">
                                @if (cita.ServicioId.HasValue)
                                {
                                    <a asp-action="Detalle"
                                       asp-route-id="@cita.ServicioId.Value"
                                       class="c-btn-sm c-btn-sm-primary"
                                       title="Ver servicio">
                                        <i class="bi bi-eye-fill me-1"></i>Ver
                                    </a>
                                }

                                @if (cita.PuedeReprogramar)
                                {
                                    <a asp-action="Reprogramar"
                                       asp-route-id="@cita.CitaId"
                                       class="c-btn-sm c-btn-sm-primary"
                                       title="Reprogramar cita">
                                        <i class="bi bi-calendar-plus me-1"></i>Reprogramar
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>