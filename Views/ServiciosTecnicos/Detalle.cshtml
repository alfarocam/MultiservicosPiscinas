@model MultiserviciosPiscinas.Models.Servicio
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Detalle del servicio técnico";

    var badgeClass = Model.Estado switch
    {
        "En progreso" => "c-badge-amber",
        "Cerrado" => "c-badge-gray",
        _ => "c-badge-blue"
    };
}

<div class="c-page-header">
    <h2><i class="bi bi-tools me-2"></i>Servicio técnico #@Model.Id</h2>
    <span class="c-badge @badgeClass" style="font-size:0.85rem;padding:6px 16px">@Model.Estado</span>
</div>

<div class="c-detail-card">
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="c-detail-field">
                <label>N° de orden</label>
                <p>@Model.Id</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="c-detail-field c-field-blue">
                <label>Cliente</label>
                <p>@Model.Cita.Piscina.Cliente.Usuario.Nombre @Model.Cita.Piscina.Cliente.Usuario.ApellidoPaterno</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="c-detail-field c-field-amber">
                <label>Técnico asignado</label>
                <p>@Model.Cita.Tecnico.Nombre @Model.Cita.Tecnico.ApellidoPaterno</p>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="c-detail-field">
                <label>Piscina</label>
                <p>@Model.Cita.Piscina.Tipo — @Model.Cita.Piscina.VolumenM3 m³</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="c-detail-field c-field-gray">
                <label>Dirección de domicilio</label>
                <p style="font-weight:400">@Model.Cita.Piscina.Direccion.Detalles, @Model.Cita.Piscina.Direccion.Distrito.Nombre</p>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="c-detail-field">
                <label>Tarea a realizar</label>
                <p>@Model.Cita.Tipo</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="c-detail-field">
                <label>Fecha y hora de apertura</label>
                <p>@Model.Cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="c-detail-field c-field-gray">
                <label>Observaciones</label>
                <p style="font-weight:400">@Model.TrabajoRealizado</p>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>