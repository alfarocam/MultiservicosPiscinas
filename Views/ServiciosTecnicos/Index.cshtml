@model List<MultiserviciosPiscinas.Models.Servicio>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Servicios técnicos";
}

<div class="c-page-header">
    <h2><i class="bi bi-tools me-2"></i>Servicios técnicos</h2>
    <a asp-action="Crear" class="btn">+ Nuevo servicio</a>
</div>

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <input type="text" name="busqueda" value="@ViewBag.Busqueda"
               class="form-control" style="max-width:300px" placeholder="Buscar por cliente, piscina, tipo o estado..." />
        <button type="submit" class="btn">
            <i class="bi bi-search me-1"></i>Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>
</div>

<div class="c-data-card">
    <table class="c-data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Piscina</th>
                <th>Tipo de servicio</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay servicios técnicos activos.</td></tr>
            }
            else
            {
                foreach (var servicio in Model)
                {
                    var cliente = servicio.Cita.Piscina.Cliente.Usuario;
                    <tr>
                        <td class="c-num">@servicio.Id</td>
                        <td class="fw-semibold">@cliente.Nombre @cliente.ApellidoPaterno</td>
                        <td>@servicio.Cita.Piscina.Tipo — @servicio.Cita.Piscina.VolumenM3 m³</td>
                        <td>@servicio.Cita.Tipo</td>
                        <td>@servicio.FechaApertura.ToString("dd/MM/yyyy")</td>
                        <td><span class="c-badge c-badge-amber">@servicio.Estado</span></td>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@servicio.Id" class="c-btn-sm c-btn-sm-primary">
                                <i class="bi bi-eye me-1"></i>Ver
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>