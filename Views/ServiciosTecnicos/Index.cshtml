@model List<MultiserviciosPiscinas.Models.Servicio>

@{
    Layout = User.IsInRole("2")
        ? "~/Views/Shared/_LayoutTecnico.cshtml"
        : "~/Views/Shared/_LayoutAdmin.cshtml";

    ViewData["Title"] = User.IsInRole("2")
        ? "Servicios Asignados"
        : "Servicios técnicos";
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="c-page-header">
    <h2>
        <i class="bi bi-tools me-2"></i>
        @(User.IsInRole("2") ? "Servicios Asignados" : "Servicios técnicos")
    </h2>

    @if (User.IsInRole("1"))
    {
        <a asp-action="Crear" class="btn">
            + Nuevo servicio
        </a>
    }
</div>

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <input type="text"
               name="busqueda"
               value="@ViewBag.Busqueda"
               class="form-control c-filter-input"
               placeholder="Buscar por cliente, piscina, tipo, fecha o estado..." />

        <button type="submit" class="btn">
            <i class="bi bi-search me-1"></i>Buscar
        </button>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                Limpiar
            </a>
        }
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaServiciosTecnicos" class="table table-hover align-middle">
                <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Usuario / Cliente</th>
                <th>Piscina</th>
                <th>Servicio</th>
                <th>Fecha apertura</th>
                <th>Fecha finalización</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        @(User.IsInRole("2")
                                            ? "No tienes servicios asignados actualmente."
                                            : "No hay servicios técnicos registrados.")
                </td>
            </tr>
                        }
            else
            {
                foreach (var servicio in Model)
                {
                    var cliente = servicio.Cita.Piscina.Cliente.Usuario;

                    var badgeClass = servicio.Estado switch
                    {
                        "Abierto" => "c-badge-blue",
                        "En progreso" => "c-badge-amber",
                        "Cerrado" => "c-badge-green",
                        "Cancelado" => "c-badge-red",
                        _ => "c-badge-gray"
                    };

                    <tr>
                        <td class="c-num">
                            @servicio.Id
                        </td>

                        <td class="fw-semibold">
                            @cliente.Nombre @cliente.ApellidoPaterno
                        </td>

                        <td>
                            @servicio.Cita.Piscina.Tipo — @servicio.Cita.Piscina.VolumenM3.ToString("0.##") m³
                        </td>

                        <td>
                            <strong>@servicio.Cita.Tipo</strong>

                            @if (servicio.TareaServicio.Any())
                            {
                                <div class="small text-muted">
                                    @servicio.TareaServicio.Count tarea(s)
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted">
                                    Sin tareas registradas
                                </div>
                            }
                </td>

                <td>
                    @servicio.FechaApertura.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @(servicio.FechaCierre.HasValue
                                        ? servicio.FechaCierre.Value.ToString("dd/MM/yyyy")
                                        : "—")
                </td>

                        <td>
                            <span class="c-badge @badgeClass">
                                @servicio.Estado
                            </span>
                        </td>

                        <td>
                            <div class="d-flex justify-content-center gap-1 flex-wrap">
                        @if (User.IsInRole("2") && servicio.Estado != "Cerrado" && servicio.Estado != "Cancelado")
                                {
                                    <a asp-action="RegistrarTareas"
                                       asp-route-id="@servicio.Id"
                                       class="c-btn-sm c-btn-sm-primary"
                                       title="Registrar tareas completadas">
                                        <i class="bi bi-list-task me-1"></i>Lista
                                    </a>
                                }

                                <a asp-action="Detalle"
                                   asp-route-id="@servicio.Id"
                                   class="c-btn-sm c-btn-sm-primary"
                                   title="Ver detalle del servicio">
                                    <i class="bi bi-eye-fill me-1"></i>Ver
                                </a>

                                @if (User.IsInRole("1") && servicio.Estado != "Cerrado" && servicio.Estado != "Cancelado")
                                {
                                    <a asp-action="CambiarTecnico"
                                       asp-route-id="@servicio.Id"
                                       class="c-btn-sm c-btn-sm-primary"
                                       title="Cambiar técnico asignado">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                }

                                @if (servicio.Estado != "Cerrado" && servicio.Estado != "Cancelado")
                                {
                                    <form asp-action="Finalizar"
                                          asp-route-id="@servicio.Id"
                                          method="post"
                                          onsubmit="return FinalizarServicio(event, this);">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="c-btn-sm c-btn-sm-primary"
                                                title="Dar por finalizado">
                                            <i class="bi bi-check-circle-fill me-1"></i>Finalizar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sweetalerts.js" asp-append-version="true"></script>
    <script src="~/js/servicios-tecnicos-tabla.js" asp-append-version="true"></script>
}