@model MultiserviciosPiscinas.Models.ReprogramarCitaTecnicoViewModel

@{
    Layout = "~/Views/Shared/_LayoutTecnico.cshtml";
    ViewData["Title"] = "Reprogramar cita";
}

<div class="c-page-header">
    <h2>
        <i class="bi bi-calendar-plus me-2"></i>
        Reprogramar cita
    </h2>

    <a asp-action="MiAgenda" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver a Mi Agenda
    </a>
</div>

<div class="c-detail-card mb-4">
    <h5 class="fw-bold mb-3" style="color: var(--color-btn-bg);">
        <i class="bi bi-info-circle-fill me-2"></i>Información de la cita
    </h5>

    <hr style="border-color: var(--color-accent);" />

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="c-detail-field c-field-blue">
                <label>Cliente</label>
                <p>@Model.Cliente</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field">
                <label>Tipo de servicio</label>
                <p>@Model.TipoServicio</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field c-field-amber">
                <label>Fecha actual</label>
                <p>@Model.FechaHoraActual.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="c-detail-field">
                <label>Piscina</label>
                <p>@Model.Piscina</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="c-detail-field c-field-gray">
                <label>Dirección</label>
                <p style="font-weight:400">@Model.Direccion</p>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3" style="color: var(--color-btn-bg);">
        <i class="bi bi-pencil-square me-2"></i>Nueva fecha y hora
    </h5>

    <hr style="border-color: var(--color-accent);" />

    <form asp-action="Reprogramar" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CitaId" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NuevaFecha" class="form-label fw-semibold"></label>
                <input asp-for="NuevaFecha"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="NuevaFecha" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="NuevaHora" class="form-label fw-semibold"></label>
                <input asp-for="NuevaHora"
                       type="time"
                       class="form-control" />
                <span asp-validation-for="NuevaHora" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Motivo" class="form-label fw-semibold"></label>
                <textarea asp-for="Motivo"
                          class="form-control"
                          rows="4"
                          placeholder="Explique brevemente por qué se reprograma la visita..."></textarea>
                <span asp-validation-for="Motivo" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn">
                <i class="bi bi-save me-1"></i>Guardar reprogramación
            </button>

            <a asp-action="MiAgenda" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>