@model MultiserviciosPiscinas.Models.RegistrarTareasViewModel

@{
    Layout = "~/Views/Shared/_LayoutTecnico.cshtml";
    ViewData["Title"] = "Registrar tareas completadas";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="c-page-header">
    <h2>
        <i class="bi bi-list-task me-2"></i>
        Registrar tareas completadas
    </h2>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="c-detail-card mb-4">

    <h5 class="fw-bold mb-3 c-section-title">
        <i class="bi bi-info-circle-fill me-2"></i>Información del servicio
    </h5>

    <hr class="c-hr-accent" />

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="c-detail-field c-field-blue">
                <label>Cliente</label>
                <p>@Model.Cliente</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field">
                <label>Piscina</label>
                <p>@Model.Piscina</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field c-field-amber">
                <label>Servicio</label>
                <p>@Model.TipoServicio</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field">
                <label>Fecha de apertura</label>
                <p>@Model.FechaApertura.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field">
                <label>Fecha de cita</label>
                <p>@Model.FechaCita.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="c-detail-field">
                <label>Tareas registradas</label>
                <p>@Model.CantidadTareas</p>
            </div>
        </div>

        <div class="col-12">
            <div class="c-detail-field c-field-gray">
                <label>Dirección</label>
                <p>@Model.Direccion</p>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3 c-section-title">
        <i class="bi bi-pencil-square me-2"></i>Nueva tarea realizada
    </h5>

    <hr class="c-hr-accent" />

    <form asp-action="RegistrarTareas" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ServicioId" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="NuevaTarea" class="form-label fw-semibold"></label>
            <textarea asp-for="NuevaTarea"
                      class="form-control"
                      rows="4"
                      placeholder="Describa la tarea realizada durante el servicio. Ejemplo: Se limpiaron filtros y se revisó bomba de circulación."></textarea>
            <span asp-validation-for="NuevaTarea" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn">
                <i class="bi bi-save me-1"></i>Guardar Tareas
            </button>

            <a asp-action="Detalle" asp-route-id="@Model.ServicioId" class="btn btn-outline-secondary">
                <i class="bi bi-eye-fill me-1"></i>Ver detalle
            </a>
        </div>
    </form>

</div>

<div class="c-detail-card">

    <h5 class="fw-bold mb-3 c-section-title">
        <i class="bi bi-clock-history me-2"></i>Tareas registradas
    </h5>

    <hr class="c-hr-accent" />

    @if (!Model.TareasRegistradas.Any())
    {
        <div class="alert alert-info mb-0">
            Todavía no hay tareas registradas para este servicio.
        </div>
    }
    else
    {
        <div class="c-data-card">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Tarea</th>
                        <th>Estado</th>
                        <th>Fecha y hora registro</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var tarea in Model.TareasRegistradas)
                    {
                        var fechaHora = tarea.FechaHoraRegistro
                        ?? tarea.FechaAsignacion.ToDateTime(TimeOnly.MinValue);

                        var tareaBadge = tarea.Estado switch
                        {
                            "Pendiente" => "c-badge-gray",
                            "En progreso" => "c-badge-amber",
                            "Completada" => "c-badge-green",
                            "Cancelada" => "c-badge-red",
                            _ => "c-badge-gray"
                        };

                        <tr>
                            <td class="c-num">@tarea.Id</td>

                            <td class="fw-semibold">
                                @tarea.Descripcion
                            </td>

                            <td>
                                <span class="c-badge @tareaBadge">
                                    @tarea.Estado
                                </span>
                            </td>

                            <td>
                                @fechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>