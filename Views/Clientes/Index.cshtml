@model IEnumerable<MultiserviciosPiscinas.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

    <div class="c-page-header d-flex justify-content-between align-items-center">
        <h2 class="a-title">Gestión de Clientes</h2>
        <a asp-action="Crear" asp-controller="Clientes" class="btn c-btn-sm-primary">
            <i class="bi bi-person-plus me-1"></i>Nuevo Cliente
        </a>
    </div>

<div class="o-form-card">
    <div class="table-responsive">
        <table id="tablaClientes" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="a-text-muted small text-uppercase">Nombre</th>
                    <th class="a-text-muted small text-uppercase">Correo</th>
                    <th class="a-text-muted small text-uppercase">Teléfono</th>
                    <th class="a-text-muted small text-uppercase text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Usuario.Nombre @cliente.Usuario.ApellidoPaterno</td>
                        <td>@cliente.Usuario.Correo</td>
                        <td>@(cliente.TelefonosCliente.FirstOrDefault()?.NumeroTelefono)</td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Detalle" asp-route-id="@cliente.Id" title="Ver detalle" class="dropdown-item">
                                            <i class="bi bi-eye me-2 text-info"></i>Ver
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="Crear" asp-controller="Piscinas" asp-route-clienteId="@cliente.Id" title="Crear piscina" class="dropdown-item">
                                            <i class="bi bi-plus-circle me-2 text-primary"></i>Crear Piscina
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="Editar" asp-route-id="@cliente.Id" title="Editar cliente" class="dropdown-item">
                                            <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                        </a>
                                    </li>
                            
                                </ul>
                            </div>
                            
                           
                            
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/clientes-tabla.js"></script>
}
