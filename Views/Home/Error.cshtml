@{
    int codigo = ViewBag.StatusCode is int c ? c : Context.Response.StatusCode;
    bool es404 = codigo == 404;
    ViewData["Title"] = es404 ? "Página no encontrada" : "Error del sistema";
}

<div class="c-page-header">
    <h2>@(es404 ? "Página o registro no encontrado" : "Error del sistema")</h2>
</div>

<div class="card border-0 shadow-sm text-center py-4">
    <div class="card-body">
        @if (es404)
        {
            <i class="bi bi-exclamation-circle display-3 text-warning"></i>
            <h4 class="mt-3">No se encontró el recurso solicitado</h4>
            <p class="text-muted mb-4">
                La ruta ingresada no existe o el registro consultado ya no está disponible (Error 404).
            </p>
        }
        else
        {
            <i class="bi bi-exclamation-triangle display-3 text-danger"></i>
            <h4 class="mt-3">Ocurrió un inconveniente al procesar la solicitud</h4>
            <p class="text-muted mb-4">
                El sistema no pudo completar la operación solicitada (Error @codigo). Por favor, vuelva al inicio e intente nuevamente.
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door me-1"></i>Volver al inicio
        </a>
    </div>
</div>
