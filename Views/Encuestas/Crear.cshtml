@model MultiserviciosPiscinas.Models.Encuesta
@{
    ViewData["Title"] = "Encuesta de Satisfacción";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2>Encuesta de Satisfacción</h2>
        <p class="a-text-light mb-0 small opacity-75">
            Calificá la calidad del mantenimiento realizado en el servicio #@Model.ServicioId.
        </p>
    </div>

    <a asp-controller="Historial"
       asp-action="Detalle"
       asp-route-id="@Model.ServicioId"
       class="c-btn-sm c-btn-sm-success me-2">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="o-form-card">
            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-star-fill me-2"></i>Calificación del servicio
            </h5>

            <hr class="c-hr-accent" />

            <input type="hidden" id="encuestaErrorServidor" value="@ViewBag.ErrorCalificacion" />

            <form id="formEncuesta" asp-action="Crear" method="post" novalidate="novalidate">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ServicioId" />

                <div class="m-form-field">
                    <label asp-for="Calificacion" class="form-label fw-semibold">
                        Calificación <span class="text-danger">*</span>
                    </label>

                    <select asp-for="Calificacion"
                            id="Calificacion"
                            class="a-input form-select">
                        <option value="" selected="@(Model.Calificacion < 1 || Model.Calificacion > 5 ? "selected" : null)">Seleccione una calificación</option>
                        <option value="1">⭐ 1 - Muy malo</option>
                        <option value="2">⭐⭐ 2 - Malo</option>
                        <option value="3">⭐⭐⭐ 3 - Regular</option>
                        <option value="4">⭐⭐⭐⭐ 4 - Bueno</option>
                        <option value="5">⭐⭐⭐⭐⭐ 5 - Excelente</option>
                    </select>

                    <span asp-validation-for="Calificacion"
                          class="text-danger small mt-1 d-block">
                    </span>
                </div>

                <div class="m-form-field">
                    <label asp-for="Comentario" class="form-label fw-semibold">
                        Comentario (opcional)
                    </label>

                    <textarea asp-for="Comentario" rows="5" class="a-input form-control" placeholder="Contanos cómo fue tu experiencia..."></textarea>
                </div>

                <div class="d-flex justify-content-end align-items-center gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>Enviar Opinión
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/encuestas-crear.js" asp-append-version="true"></script>
}
