@model List<MultiserviciosPiscinas.DTOs.HistorialServicioDto>
@{
    ViewData["Title"] = "Historial de Servicios";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>Historial de Servicios</h2>
</div>

<div class="c-data-card mb-4 p-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha desde</label>
            <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha hasta</label>
            <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-info w-100">
                <i class="bi bi-funnel-fill me-1"></i>Filtrar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-lg me-1"></i>Limpiar
            </a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i>No hay servicios registrados en el período seleccionado.
    </div>
}
else
{
    int index = 1;
    <div class="d-flex flex-column gap-3 mb-4">
        @foreach (var item in Model)
        {
            string badgeClass = item.EstadoServicio == "Cerrado" ? "c-badge-green"
                              : item.EstadoServicio == "En progreso" ? "c-badge-amber"
                              : item.EstadoServicio == "Cancelado" ? "c-badge-red"
                              : "c-badge-blue";

            <div class="card shadow-sm border-0">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3 p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="badge bg-light text-primary fs-6 fw-bold p-3 rounded-3 border">
                            #@index
                        </div>
                        <div>
                            <h5 class="fw-semibold mb-1">@item.Tipo</h5>
                            <div class="text-muted small d-flex flex-wrap gap-3">
                                <span><i class="bi bi-calendar-event me-1"></i>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                                <span><i class="bi bi-person me-1"></i>@item.NombreTecnico</span>
                                @if (item.FechaCierre.HasValue)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i>Cerrado @item.FechaCierre.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="c-badge @badgeClass">@item.EstadoServicio</span>
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="c-btn-sm btn-info">
                            <i class="bi bi-eye me-1"></i>Ver detalle
                        </a>
                    </div>
                </div>
            </div>
            index++;
        }
    </div>
    <p class="text-muted small">@Model.Count servicio(s) encontrado(s)</p>
}
