@model MultiserviciosPiscinas.DTOs.DetalleServicioDto
@{
    ViewData["Title"] = "Detalle del Servicio";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="c-page-header d-flex justify-content-between align-items-center mb-4">
    <h2>Servicio #@Model.Id</h2>
    <a asp-action="Index" class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Volver al historial
    </a>
</div>

<!-- Información general -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light fw-bold text-uppercase small text-muted">
        <i class="bi bi-card-text me-2"></i>Información General
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase">Tipo</label>
                <div class="fw-semibold">@Model.Tipo</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase">Fecha de Cita</label>
                <div class="fw-semibold">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase">Técnico</label>
                <div class="fw-semibold">@Model.NombreTecnico</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase">Estado</label>
                <div>
                    @{
                        string badgeClass = Model.EstadoServicio == "Cerrado" ? "c-badge-green"
                                          : Model.EstadoServicio == "En progreso" ? "c-badge-amber"
                                          : Model.EstadoServicio == "Cancelado" ? "c-badge-red"
                                          : "c-badge-blue";
                    }
                    <span class="c-badge @badgeClass">@Model.EstadoServicio</span>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase">Fecha Apertura</label>
                <div class="fw-semibold">@Model.FechaApertura.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase">Fecha Cierre</label>
                <div class="fw-semibold">
                    @(Model.FechaCierre.HasValue ? Model.FechaCierre.Value.ToString("dd/MM/yyyy") : "Pendiente")
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notas))
            {
                <div class="col-12">
                    <label class="form-label text-muted small text-uppercase">Notas</label>
                    <div class="fw-semibold">@Model.Notas</div>
                </div>
            }
            <div class="col-12">
                <label class="form-label text-muted small text-uppercase">Trabajo Realizado</label>
                <div class="fw-semibold">@Model.TrabajoRealizado</div>
            </div>
        </div>
    </div>
</div>

<!-- Tareas -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light fw-bold text-uppercase small text-muted">
        <i class="bi bi-check-square me-2"></i>Tareas del Servicio
    </div>
    <div class="card-body p-0">
        @if (!Model.Tareas.Any())
        {
            <p class="text-muted p-3 mb-0 small">No hay tareas registradas.</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var tarea in Model.Tareas)
                {
                    string badgeT = tarea.Estado == "Completada" ? "c-badge-green"
                                  : tarea.Estado == "En progreso" ? "c-badge-amber"
                                  : tarea.Estado == "Cancelada" ? "c-badge-red"
                                  : "c-badge-blue";

                    <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                        <div>
                            <div class="fw-semibold mb-1">@tarea.Descripcion</div>
                            <div class="text-muted small">
                                Asignado: @tarea.FechaAsignacion.ToString("dd/MM/yyyy")
                                @if (tarea.FechaCompletacion.HasValue)
                                {
                                    <text> → Completado: @tarea.FechaCompletacion.Value.ToString("dd/MM/yyyy")</text>
                                }
                            </div>
                        </div>
                        <span class="c-badge @badgeT">@tarea.Estado</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Inspección química -->
@if (Model.Inspeccion != null)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light fw-bold text-uppercase small text-muted">
            <i class="bi bi-droplet-half me-2"></i>Inspección Química — @Model.Inspeccion.FechaInspeccion.ToString("dd/MM/yyyy")
        </div>
        <div class="card-body">
            <div class="row g-3 text-center mb-3">
                @if (Model.Inspeccion.CloroPpm.HasValue)
                {
                    <div class="col">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="fs-4 fw-bold text-primary d-block">@Model.Inspeccion.CloroPpm.Value.ToString("F2")</span>
                            <span class="small text-muted fw-semibold">Cloro (ppm)</span>
                        </div>
                    </div>
                }
                @if (Model.Inspeccion.Ph.HasValue)
                {
                    <div class="col">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="fs-4 fw-bold text-primary d-block">@Model.Inspeccion.Ph.Value.ToString("F2")</span>
                            <span class="small text-muted fw-semibold">pH</span>
                        </div>
                    </div>
                }
                @if (Model.Inspeccion.Alcalinidad.HasValue)
                {
                    <div class="col">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="fs-4 fw-bold text-primary d-block">@Model.Inspeccion.Alcalinidad.Value.ToString("F2")</span>
                            <span class="small text-muted fw-semibold">Alcalinidad</span>
                        </div>
                    </div>
                }
                @if (Model.Inspeccion.Calcio.HasValue)
                {
                    <div class="col">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="fs-4 fw-bold text-primary d-block">@Model.Inspeccion.Calcio.Value.ToString("F2")</span>
                            <span class="small text-muted fw-semibold">Calcio</span>
                        </div>
                    </div>
                }
                @if (Model.Inspeccion.AcidoCianurico.HasValue)
                {
                    <div class="col">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="fs-4 fw-bold text-primary d-block">@Model.Inspeccion.AcidoCianurico.Value.ToString("F2")</span>
                            <span class="small text-muted fw-semibold">Ác. Cianúrico</span>
                        </div>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.Inspeccion.Observaciones))
            {
                <div class="p-3 bg-light rounded-3 border">
                    <strong class="small text-uppercase text-muted d-block mb-1">Observaciones</strong>
                    <div>@Model.Inspeccion.Observaciones</div>
                </div>
            }
        </div>
    </div>
}

<!-- Encuesta de satisfacción -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light fw-bold text-uppercase small text-muted">
        <i class="bi bi-star me-2"></i>Encuesta de Satisfacción
    </div>
    <div class="card-body">
        @if (ViewBag.YaCalificado == true)
        {
            <div class="alert alert-success mb-0">
                <i class="bi bi-check-circle me-1"></i>Este servicio ya ha sido calificado, gracias.
            </div>
        }
        else if (Model.EstadoServicio == "Cerrado")
        {
            <p class="text-muted mb-3">
                ¿Cómo fue tu experiencia con este mantenimiento?
            </p>
            <a asp-controller="Encuestas"
               asp-action="Crear"
               asp-route-servicioId="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-star-fill me-1"></i>Completar encuesta
            </a>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-1"></i>La encuesta estará disponible cuando el servicio esté cerrado.
            </div>
        }
    </div>
</div>
