@model MultiserviciosPiscinas.Models.ProyectoEditViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Editar Proyecto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="a-title mb-0">
        <i class="bi bi-pencil-square me-2"></i>Editar Proyecto
    </h2>

    <a asp-action="Detalle" asp-controller="Proyecto" asp-route-id="@Model.Id" class="btn btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="card">
    <div class="card-body">

        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ClienteId" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-person-fill me-2"></i>Cliente y piscina
            </h5>

            <hr class="c-hr-accent" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cliente</label>
                    <input type="text"
                           class="form-control c-input-disabled"
                           value="@ViewBag.NombreCliente"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="PiscinaId" class="form-label fw-semibold"></label>
                    <select asp-for="PiscinaId" class="form-select">
                        <option value="">Sin piscina asociada (opcional)</option>

                        @foreach (var p in ViewBag.Piscinas)
                        {
                            if (Model.PiscinaId == p.id)
                            {
                                <option value="@p.id" selected>@p.texto</option>
                            }
                            else
                            {
                                <option value="@p.id">@p.texto</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="PiscinaId" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-clipboard-fill me-2"></i>Información del proyecto
            </h5>

            <hr class="c-hr-accent" />

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label fw-semibold"></label>
                    <input asp-for="Nombre" class="form-control" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Estado" class="form-label fw-semibold"></label>
                    <select asp-for="Estado" class="form-select" required>
                        <option value="">Seleccione un estado...</option>

                        @foreach (var estado in ViewBag.Estados)
                        {
                            if (Model.Estado == estado)
                            {
                                <option value="@estado" selected>@estado</option>
                            }
                            else
                            {
                                <option value="@estado">@estado</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Estado" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="3"
                              placeholder="Descripción general del proyecto, alcance, materiales, etc."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold mb-3 c-section-title">
                <i class="bi bi-calendar-event-fill me-2"></i>Fechas y presupuesto
            </h5>

            <hr class="c-hr-accent" />

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="FechaInicio" class="form-label fw-semibold"></label>
                    <input asp-for="FechaInicio" type="date" class="form-control" required />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaFinEstimada" class="form-label fw-semibold"></label>
                    <input asp-for="FechaFinEstimada" type="date" class="form-control" />
                    <span asp-validation-for="FechaFinEstimada" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Presupuesto" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        <input asp-for="Presupuesto"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               required />
                    </div>
                    <span asp-validation-for="Presupuesto" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-2">
                <a asp-action="Detalle"
                   asp-controller="Proyecto"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill me-1"></i>Guardar Cambios
                </button>
            </div>

        </form>

    </div>
</div>