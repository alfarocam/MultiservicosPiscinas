@model IEnumerable<MultiserviciosPiscinas.Models.ProyectoConstruccion>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Proyectos";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="a-title mb-0">
        Proyectos
    </h2>

    <a asp-action="Crear" asp-controller="Proyecto" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Proyecto
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-folder-x c-empty-state-icon"></i>
                <h4 class="mt-3">No hay proyectos registrados</h4>
                <p class="a-text-muted">Cree un nuevo proyecto para comenzar a controlar su progreso.</p>
            </div>
        }
        else
        {
            <table id="tablaProyectos" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th class="a-text-muted small text-uppercase" hidden>ID</th>
                        <th class="a-text-muted small text-uppercase">Nombre del Cliente</th>
                        <th class="a-text-muted small text-uppercase">Nombre del Proyecto</th>
                        <th class="a-text-muted small text-uppercase">Fecha Inicio</th>
                        <th class="a-text-muted small text-uppercase">Fecha Fin Estimada</th>
                        <th class="a-text-muted small text-uppercase">Estado</th>
                        <th class="a-text-muted small text-uppercase">Presupuesto</th>
                        <th class="a-text-muted small text-uppercase text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var proyecto in Model)
                    {
                        var esEditable = proyecto.Estado != "Completado" && proyecto.Estado != "Cancelado";

                        var badgeClass = proyecto.Estado switch
                        {
                            "En Planificación" => "c-badge-blue",
                            "En ejecución" => "c-badge-green",
                            "Pausado" => "c-badge-amber",
                            "Completado" => "c-badge-green",
                            "Cancelado" => "c-badge-red",
                            _ => "c-badge-gray"
                        };

                        <tr>
                            <td hidden>@proyecto.Id</td>

                            <td>
                                @proyecto.Cliente.Usuario.Nombre
                                @proyecto.Cliente.Usuario.ApellidoPaterno
                                @proyecto.Cliente.Usuario.ApellidoMaterno
                            </td>

                            <td>
                                <strong>@proyecto.Nombre</strong>

                                @if (proyecto.Piscina != null)
                                {
                                    <div class="small a-text-muted">
                                        Piscina: @proyecto.Piscina.Tipo
                                    </div>
                                }
                        </td>

                        <td>@proyecto.FechaInicio.ToString("dd/MM/yyyy")</td>

                        <td>
                            @(proyecto.FechaFinEstimada.HasValue
                                                    ? proyecto.FechaFinEstimada.Value.ToString("dd/MM/yyyy")
                                                    : "—")
                    </td>

                            <td>
                                <span class="c-badge @badgeClass">
                                    @proyecto.Estado
                                </span>
                            </td>

                            <td>@proyecto.Presupuesto.ToString("C")</td>

                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a asp-action="Detalle" asp-controller="Proyecto" asp-route-id="@proyecto.Id" class="dropdown-item">
                                                <i class="bi bi-eye me-2 text-info"></i>Ver
                                            </a>
                                        </li>
                                        @if (esEditable)
                                        {
                                            <li>
                                                <a asp-action="Editar" asp-controller="Proyecto" asp-route-id="@proyecto.Id" class="dropdown-item">
                                                    <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li title="Este proyecto no se puede editar porque está completado o cancelado">
                                                <span class="dropdown-item disabled text-muted" title="Este proyecto no se puede editar porque está completado o cancelado">
                                                    <i class="bi bi-lock-fill me-2 text-secondary"></i>Cerrado
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/proyecto-tabla.js" asp-append-version="true"></script>
}