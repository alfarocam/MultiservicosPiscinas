@model MultiserviciosPiscinas.Models.RutaOptimizadaViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Ruta Optimizada";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="a-title mb-0">
        Ruta Optimizada
    </h2>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Técnico</label>
                <select name="tecnicoId" class="form-select" required>
                    <option value="">Seleccione un técnico...</option>
                    @foreach (var tecnico in ViewBag.Tecnicos)
                    {
                        <option value="@tecnico.Id" selected="@(tecnico.Id == (int?)ViewBag.TecnicoId)">
                            @tecnico.Nombre @tecnico.ApellidoPaterno
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Fecha</label>
                <input type="date" name="fecha" class="form-control"
                       value="@(((DateOnly)ViewBag.FechaSeleccionada).ToString("yyyy-MM-dd"))" required />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-search me-1"></i> Ver ruta
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.TecnicoId == 0)
{
    <div class="alert alert-info">
        Selecciona un técnico y una fecha para ver su ruta.
    </div>
}
else if (!Model.TieneSuficientesParadas)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Se necesitan al menos dos destinos para optimizar una ruta.
        El técnico <strong>@Model.TecnicoNombre</strong> tiene
        @Model.Paradas.Count cita(s) asignada(s) el @Model.Fecha.ToString("dd/MM/yyyy").
    </div>
}
else if (!Model.TieneSuficientesParadasConCoordenadas)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        El técnico <strong>@Model.TecnicoNombre</strong> tiene
        @Model.Paradas.Count cita(s) el @Model.Fecha.ToString("dd/MM/yyyy"),
        pero solo @Model.ParadasConCoordenadas con ubicación marcada en el mapa.
        Se necesitan al menos dos direcciones con coordenadas para calcular la ruta.
        <div class="mt-2 mb-0">
            Faltan coordenadas en:
            <ul class="mb-0">
                @foreach (var parada in Model.Paradas.Where(p => !p.TieneCoordenadas))
                {
                    <li>@parada.ClienteNombre — @parada.Direccion</li>
                }
            </ul>
        </div>
        Editá esas direcciones en <strong>Clientes</strong> y marcá el pin en el mapa para poder incluirlas en la ruta.
    </div>
}
else
{
    <form id="formTokenRuta" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="row g-3">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body p-0">
                    <div id="mapaRuta" class="c-map-container"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-list-ol me-2"></i>Orden sugerido de visitas
                    </h5>
                    <ol id="listaParadas" class="ps-3"></ol>

                    <div id="resumenRuta" class="alert alert-info fw-semibold text-center mb-2">
                        Calculando ruta optimizada...
                    </div>

                    <div id="estadoGuardadoRuta" class="small text-center mb-3 @(Model.TieneRutaOptimizada ? "text-success" : "text-muted")">
                        @(Model.TieneRutaOptimizada ? "Esta fecha ya cuenta con una ruta guardada (se actualizará automáticamente)." : "")
                    </div>

                    <button id="btnGuardarRuta" type="button" class="btn btn-success w-100 mb-2" disabled>
                        <i class="bi bi-save me-1"></i> Guardar ruta optimizada
                    </button>

                    <button id="btnExportar" type="button" class="btn btn-primary w-100" disabled>
                        <i class="bi bi-google me-1"></i> Exportar a Google Maps
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="datosRutaAdmin">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            tecnicoId = Model.TecnicoId,
            fecha = Model.Fecha.ToString("yyyy-MM-dd"),
            guardarUrl = Url.Action("GuardarRuta", "RutaOptimizada"),
            paradas = Model.Paradas.Where(p => p.TieneCoordenadas).Select(p => new
            {
                citaId = p.CitaId,
                cliente = p.ClienteNombre,
                direccion = p.Direccion,
                lat = p.Latitud,
                lng = p.Longitud,
                hora = p.HoraCita.ToString("HH:mm")
            })
        }))
    </script>
}

@section Scripts {
    @if (Model.TieneSuficientesParadasConCoordenadas)
    {
        <script src="~/js/ruta-optimizada.js" asp-append-version="true"></script>
        <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&callback=iniciarMapa&loading=async"
                async defer></script>
    }
}
