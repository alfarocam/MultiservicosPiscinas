@model MultiserviciosPiscinas.Models.RutaOptimizadaViewModel

@{
    Layout = "~/Views/Shared/_LayoutTecnico.cshtml";
    ViewData["Title"] = "Mi Ruta del Día";

    var siguienteDestino = Model.Paradas
        .Where(p => p.EstadoCita != "Completada" && p.EstadoCita != "Cancelada")
        .OrderBy(p => p.OrdenVisita)
        .FirstOrDefault();

    var siguienteCitaId = siguienteDestino?.CitaId;
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>
        Mi Ruta del Día
    </h2>

    <a asp-controller="ServiciosTecnicos"
       asp-action="Index"
       class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Servicios Asignados
    </a>
</div>

<div class="c-detail-card mb-4">
    <form method="get" asp-action="MiRutaDelDia" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha</label>
            <input type="date"
                   name="fecha"
                   class="form-control"
                   value="@Model.Fecha.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-info w-100">
                <i class="bi bi-search me-1"></i>
                Consultar
            </button>
        </div>

        <div class="col-md-3">
            <a asp-action="MiRutaDelDia" class="btn btn-outline-info w-100">
                Hoy
            </a>
        </div>
    </form>
</div>

<div class="c-detail-card mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <div class="c-detail-field c-field-blue">
                <label>Fecha consultada</label>
                <p>@Model.Fecha.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="c-detail-field c-field-amber">
                <label>Total de visitas</label>
                <p>@Model.Paradas.Count</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="c-detail-field">
                <label>Distancia estimada</label>
                <p>
                    @(Model.DistanciaTotalKm.HasValue
                                        ? $"{Model.DistanciaTotalKm.Value:0.0} km"
                                        : "No registrada")
                </p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="c-detail-field">
                <label>Tiempo estimado</label>
                <p>
                    @(Model.DuracionTotalMin.HasValue
                                        ? $"{Model.DuracionTotalMin.Value} min"
                                        : "No registrado")
                </p>
            </div>
        </div>
    </div>
</div>

@if (!Model.TieneRutaOptimizada)
{
    <div class="c-detail-card text-center py-5">
        <i class="bi bi-exclamation-triangle display-5 text-warning"></i>

        <h4 class="mt-3">
            No hay ruta optimizada para esta fecha
        </h4>

        <p class="text-muted mb-0">
            El administrador debe generar una ruta optimizada para que el técnico pueda visualizarla.
        </p>
    </div>
}
else if (!Model.Paradas.Any())
{
    <div class="c-detail-card text-center py-5">
        <i class="bi bi-info-circle display-5 text-muted"></i>

        <h4 class="mt-3">
            La ruta no tiene visitas asignadas
        </h4>

        <p class="text-muted mb-0">
            No existen paradas registradas para la ruta consultada.
        </p>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="c-detail-card">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-map me-2"></i>
                    Mapa de la ruta
                </h5>

                @if (Model.ParadasConCoordenadas == 0)
                {
                    <div class="alert alert-warning mb-0">
                        Las direcciones de esta ruta no tienen coordenadas registradas.
                        Debe completar latitud y longitud para mostrar el mapa.
                    </div>
                }
                else
                {
                    <div id="mapaRutaTecnico"
                         style="width:100%; height:520px; border-radius:16px; overflow:hidden;">
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="c-detail-card">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-list-ol me-2"></i>
                    Orden de visitas
                </h5>

                <div class="d-flex flex-column gap-3">
                    @foreach (var parada in Model.Paradas.OrderBy(p => p.OrdenVisita))
                    {
                        var esSiguiente = parada.CitaId == siguienteCitaId;
                        var estaCompletada = parada.EstadoCita == "Completada";
                        var estaCancelada = parada.EstadoCita == "Cancelada";

                        <div class="border rounded-3 p-3 @(esSiguiente ? "border-primary shadow-sm" : "")">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold">
                                        #@parada.OrdenVisita - @parada.ClienteNombre
                                    </div>

                                    <div class="small text-muted">
                                        @parada.TipoServicio · @parada.HoraCita.ToString("HH:mm")
                                    </div>
                                </div>

                                @if (estaCompletada)
                                {
                                    <span class="badge bg-success">
                                        Completada
                                    </span>
                                }
                                else if (estaCancelada)
                                {
                                    <span class="badge bg-danger">
                                        Cancelada
                                    </span>
                                }
                                else if (esSiguiente)
                                {
                                    <span class="badge bg-primary">
                                        Siguiente
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Pendiente
                                    </span>
                                }
                        </div>

                        <div class="mt-2 small">
                            <i class="bi bi-geo-alt me-1"></i>
                            @parada.Direccion
                        </div>

                        <div class="mt-2 small text-muted">
                            <div>
                                Distancia del tramo:
                                @(parada.DistanciaTramoKm.HasValue
                                                            ? $"{parada.DistanciaTramoKm.Value:0.0} km"
                                                            : "No registrada")
                                                                          </div>

                            <div>
                                Tiempo estimado:
                                @(parada.DuracionTramoMin.HasValue
                                                            ? $"{parada.DuracionTramoMin.Value} min"
                                                            : "No registrado")
                        </div>
                    </div>

                    @if (esSiguiente && !estaCompletada && !estaCancelada)
                            {
                                <form asp-action="MarcarCompletada"
                                      method="post"
                                      class="mt-3"
                                      onsubmit="return confirm('¿Desea marcar esta visita como completada?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="visitaRutaId"
                                           value="@parada.VisitaRutaId" />

                                    <button type="submit" class="btn w-100">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Marcar como Completada
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.EnlaceGoogleMaps))
                {
                    <a href="@Model.EnlaceGoogleMaps"
                       target="_blank"
                       class="btn w-100 mt-3">
                        <i class="bi bi-google me-1"></i>
                        Abrir en Google Maps
                    </a>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.TieneRutaOptimizada && Model.ParadasConCoordenadas > 0)
    {
        <script>
            const paradasRuta = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.Paradas
                                .Where(p => p.TieneCoordenadas)
                                .OrderBy(p => p.OrdenVisita)
                                .Select(p => new
                                {
                                        visitaRutaId = p.VisitaRutaId,
                                        citaId = p.CitaId,
                                        orden = p.OrdenVisita,
                                        cliente = p.ClienteNombre,
                                        direccion = p.Direccion,
                                        lat = p.Latitud,
                                        lng = p.Longitud,
                                        estado = p.EstadoCita,
                                        hora = p.HoraCita.ToString("HH:mm"),
                                        esSiguiente = p.CitaId == siguienteCitaId
                                })
                ));

    let mapaRutaTecnico;
    let directionsService;
    let directionsRenderer;

            function iniciarMapaRutaTecnico() {
                if (!paradasRuta || paradasRuta.length === 0) {
                    return;
                }

                mapaRutaTecnico = new google.maps.Map(document.getElementById("mapaRutaTecnico"), {
                    zoom: 12,
                    center: {
                        lat: paradasRuta[0].lat,
                        lng: paradasRuta[0].lng
                    }
                });

                directionsService = new google.maps.DirectionsService();
                directionsRenderer = new google.maps.DirectionsRenderer({
                    map: mapaRutaTecnico,
                    suppressMarkers: true
                });

                crearMarcadores();

                if (paradasRuta.length >= 2) {
                    dibujarRuta();
                }
            }

            function crearMarcadores() {
                const bounds = new google.maps.LatLngBounds();

                paradasRuta.forEach(p => {
                    let color = "#009999";

                    if (p.estado === "Completada") {
                        color = "#198754";
                    }

                    if (p.esSiguiente) {
                        color = "#0d6efd";
                    }

                    const posicion = {
                        lat: p.lat,
                        lng: p.lng
                    };

                    new google.maps.Marker({
                        position: posicion,
                        map: mapaRutaTecnico,
                        label: {
                            text: String(p.orden),
                            color: "white",
                            fontWeight: "bold"
                        },
                        icon: {
                            path: google.maps.SymbolPath.CIRCLE,
                            fillColor: color,
                            fillOpacity: 1,
                            strokeColor: "white",
                            strokeWeight: 2,
                            scale: p.esSiguiente ? 13 : 10
                        },
                        title: `${p.orden}. ${p.cliente}`
                    });

                    const info = new google.maps.InfoWindow({
                        content: `
                            <div style="max-width:240px">
                                <strong>${p.orden}. ${p.cliente}</strong><br>
                                <span>${p.direccion}</span><br>
                                <small>Hora: ${p.hora}</small><br>
                                <small>Estado: ${p.estado}</small>
                            </div>
                        `
                    });

                    const markerPosition = new google.maps.LatLng(p.lat, p.lng);
                    bounds.extend(markerPosition);
                });

                mapaRutaTecnico.fitBounds(bounds);
            }

            function dibujarRuta() {
                const origen = paradasRuta[0];
                const destino = paradasRuta[paradasRuta.length - 1];
                const intermedias = paradasRuta.slice(1, paradasRuta.length - 1);

                const waypoints = intermedias.map(p => ({
                    location: {
                        lat: p.lat,
                        lng: p.lng
                    },
                    stopover: true
                }));

                directionsService.route({
                    origin: {
                        lat: origen.lat,
                        lng: origen.lng
                    },
                    destination: {
                        lat: destino.lat,
                        lng: destino.lng
                    },
                    waypoints: waypoints,
                    optimizeWaypoints: false,
                    travelMode: google.maps.TravelMode.DRIVING
                }, function (resultado, estado) {
                    if (estado === "OK") {
                        directionsRenderer.setDirections(resultado);
                    }
                });
            }
        </script>

        <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&callback=iniciarMapaRutaTecnico&loading=async"
                async defer></script>
    }
}