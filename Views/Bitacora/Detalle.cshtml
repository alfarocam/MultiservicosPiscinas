@model MultiserviciosPiscinas.Models.BitacoraAuditoria

@{
    ViewData["Title"] = "Detalle del Cambio";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Auditoría Registro #@Model.Id</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tabla Afectada:</dt>
                <dd class="col-sm-9">@Model.TablaAfectada</dd>

                <dt class="col-sm-3">Operacion:</dt>
                <dd class="col-sm-9">@Model.Accion</dd>

                <dt class="col-sm-3">Valor Anterior:</dt>
                <dd class="col-sm-9">
                    <pre class="bg-light p-2 border">@(Model.ValorAnterior ?? "N/A (Registro Nuevo)")</pre>
                </dd>

                <dt class="col-sm-3">Valor Nuevo:</dt>
                <dd class="col-sm-9">
                    <pre class="bg-light p-2 border">@Model.ValorNuevo</pre>
                </dd>
            </dl>
            <a asp-action="Index" class="btn btn-success">
            <i class="bi bi-arrow-left me-1"></i>Volver</a>
        </div>
    </div>
</div>