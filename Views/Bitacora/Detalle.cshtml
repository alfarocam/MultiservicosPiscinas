@model MultiserviciosPiscinas.Models.BitacoraAuditoria

@functions {
    // Nombre entendible de cada módulo (la bitácora guarda el nombre técnico de la tabla).
    static string NombreModulo(string tabla) => tabla switch
    {
        "inv.PRODUCTO" => "Inventario (productos)",
        "ops.CITA" => "Agenda (citas)",
        "seg.USUARIO" => "Usuarios y roles",
        "fin.GASTO_OPERATIVO" => "Gastos operativos",
        _ => tabla
    };

    // Convierte "Campo: valor | Campo: valor" en pares (campo, valor).
    static List<(string Campo, string Valor)> Separar(string? texto)
    {
        var pares = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(texto)) return pares;

        foreach (var parte in texto.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var indice = parte.IndexOf(':');
            if (indice > 0)
                pares.Add((parte[..indice].Trim(), parte[(indice + 1)..].Trim()));
            else
                pares.Add(("Detalle", parte));
        }
        return pares;
    }
}

@{
    ViewData["Title"] = "Detalle del Cambio";

    var textoAccion = Model.Accion switch
    {
        "INSERT" => "Se registró un elemento nuevo",
        "UPDATE" => "Se modificó un elemento",
        "DELETE" => "Se eliminó un elemento",
        _ => Model.Accion
    };

    var badgeClass = Model.Accion switch
    {
        "INSERT" => "c-badge-green",
        "UPDATE" => "c-badge-amber",
        "DELETE" => "c-badge-red",
        _ => "c-badge-gray"
    };

    var anteriores = Separar(Model.ValorAnterior)
        .GroupBy(p => p.Campo)
        .ToDictionary(g => g.Key, g => g.First().Valor);
    var nuevos = Separar(Model.ValorNuevo);
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2 class="mb-0">Detalle del cambio</h2>
    <a asp-action="Index" class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <span class="c-badge @badgeClass mb-3 d-inline-block">@textoAccion</span>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="a-text-muted small">Cuándo</div>
                <div class="fw-semibold">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-4">
                <div class="a-text-muted small">Quién lo hizo</div>
                <div class="fw-semibold">@Model.Usuario.Nombre @Model.Usuario.ApellidoPaterno</div>
                <div class="small text-muted">@Model.Usuario.Correo</div>
            </div>
            <div class="col-md-4">
                <div class="a-text-muted small">Dónde</div>
                <div class="fw-semibold">@NombreModulo(Model.TablaAfectada)</div>
                <div class="small text-muted">Elemento número @Model.RegistroId</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">¿Qué cambió?</h5>

        @if (nuevos.Count == 0)
        {
            <p class="text-muted mb-0">No hay información adicional registrada para este cambio.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Dato</th>
                            @if (Model.Accion == "UPDATE")
                            {
                                <th>Antes</th>
                            }
                            <th>@(Model.Accion == "DELETE" ? "Dato eliminado" : "Ahora")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (campo, valor) in nuevos)
                        {
                            var antes = anteriores.TryGetValue(campo, out var valorAnterior) ? valorAnterior : "—";
                            var cambio = Model.Accion == "UPDATE" && antes != valor;

                            <tr class="@(cambio ? "table-warning" : "")">
                                <td class="fw-semibold">@campo</td>
                                @if (Model.Accion == "UPDATE")
                                {
                                    <td>@antes</td>
                                }
                                <td>@valor</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Accion == "UPDATE")
            {
                <p class="small text-muted mt-3 mb-0">Las filas resaltadas son los datos que cambiaron.</p>
            }
        }
    </div>
</div>
