@model IEnumerable<MultiserviciosPiscinas.Models.BitacoraAuditoria>

@{
    ViewData["Title"] = "Bitácora";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex align-items-center mb-4 p-3 bg-dark text-white rounded shadow-sm">
        <h3 class="mb-0"><i class="bi bi-shield-check"></i> HU-7.2 – Bitácora</h3>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                
                <div class="col-md-3">
                    <label class="form-label font-weight-bold">Filtrar por Acción</label>
                    <select name="accion" class="form-select">
                        <option value="">-- Todas --</option>
                        <option value="INSERT" selected="@(ViewBag.FiltroAccion == "INSERT")">INSERT</option>
                        <option value="UPDATE" selected="@(ViewBag.FiltroAccion == "UPDATE")">UPDATE</option>
                        <option value="DELETE" selected="@(ViewBag.FiltroAccion == "DELETE")">DELETE</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label font-weight-bold">Buscar por Tabla SQL</label>
                    <input type="text" name="tabla" class="form-control" placeholder="Ej: USUARIO" value="@ViewBag.FiltroTabla" />
                </div>

                <div class="col-md-3">
                    <label class="form-label font-weight-bold">Ordenar por Fecha</label>
                    <select name="orden" class="form-select">
                        <option value="recientes" selected="@(ViewBag.FiltroOrden == "recientes")">Mais recientes primero</option>
                        <option value="antiguos" selected="@(ViewBag.FiltroOrden == "antiguos")">Mas antiguos primero</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-info text-white w-100">
                        <i class="bi bi-funnel"></i> Aplicar
                    </button>
                    <a href="@Url.Action("Index", "Bitacora")" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Fecha y Hora</th>
                            <th>Colaborador / Usuario</th>
                            <th>Operación</th>
                            <th>Tabla SQL</th>
                            <th>ID Reg.</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle"></i> No se encontraron registros con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 font-weight-bold">@item.Id</td>
                                    <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.Usuario != null ? $"{item.Usuario.Nombre} {item.Usuario.ApellidoPaterno}" : $"ID: {item.UsuarioId}")</td>
                                    <td>
                                        @if (item.Accion == "INSERT")
                                        {
                                            <span class="badge bg-success bg-opacity-75 text-white">Registro nuevo</span>
                                        }
                                        else if (item.Accion == "UPDATE")
                                        {
                                            <span class="badge bg-warning bg-opacity-75 text-dark">Modificacion</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-75 text-white">@item.Accion</span>
                                        }
                                    </td>
                                    <td><code class="text-dark font-weight-bold">@item.TablaAfectada</code></td>
                                    <td>@item.RegistroId</td>
                                    <td class="text-center">
                                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i> Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>