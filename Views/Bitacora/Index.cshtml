@model IEnumerable<MultiserviciosPiscinas.Models.BitacoraAuditoria>

@{
    ViewData["Title"] = "Bitácora";
}

<div class="c-page-header">
    <h2></i>Bitácora</h2>
</div>

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <select name="accion" class="form-select" style="max-width: 220px;">
            <option value="">-- Todas las acciones --</option>
            <option value="INSERT" selected="@(ViewBag.FiltroAccion == "INSERT")">Registro nuevo</option>
            <option value="UPDATE" selected="@(ViewBag.FiltroAccion == "UPDATE")">Modificación</option>
            <option value="DELETE" selected="@(ViewBag.FiltroAccion == "DELETE")">Eliminación</option>
        </select>

        <select name="orden" class="form-select" style="max-width: 220px;">
            <option value="recientes" selected="@(ViewBag.FiltroOrden != "antiguos")">Más recientes primero</option>
            <option value="antiguos" selected="@(ViewBag.FiltroOrden == "antiguos")">Más antiguos primero</option>
        </select>

        <button type="submit" class="btn">
            <i class="bi bi-funnel me-1"></i>Aplicar
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Limpiar
        </a>
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaBitacora" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Fecha y Hora</th>
                        <th>Colaborador / Usuario</th>
                        <th>Operación</th>
                        <th>ID Reg.</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var badgeClass = item.Accion switch
                            {
                                "INSERT" => "c-badge-green",
                                "UPDATE" => "c-badge-amber",
                                "DELETE" => "c-badge-red",
                                _ => "c-badge-gray"
                            };

                            var textoAccion = item.Accion switch
                            {
                                "INSERT" => "Registro nuevo",
                                "UPDATE" => "Modificación",
                                "DELETE" => "Eliminación",
                                _ => item.Accion
                            };

                            <tr>
                                <td class="c-num">@item.Id</td>
                                <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold">@(item.Usuario != null ? $"{item.Usuario.Nombre} {item.Usuario.ApellidoPaterno}" : $"ID: {item.UsuarioId}")</td>
                                <td><span class="c-badge @badgeClass">@textoAccion</span></td>
                                <td>@item.RegistroId</td>
                                <td class="text-center">
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="c-btn-sm btn-info">
                                        <i class="bi bi-eye me-1"></i>Ver detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bitacora-tabla.js" asp-append-version="true"></script>
}
