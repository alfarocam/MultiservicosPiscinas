@model MultiserviciosPiscinas.Models.Producto

@{
    ViewData["Title"] = "Editar producto";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>Editar producto</h2>
    <a asp-action="Index" class="btn btn-success">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label">Nombre del producto</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="CategoriaId" class="form-label mb-0">Categoría</label>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
                            <i class="bi bi-plus-circle me-1"></i>Nueva categoría
                        </button>
                    </div>
                    <select asp-for="CategoriaId" class="form-select">
                        <option value="">-- Seleccione una categoría --</option>
                        @foreach (var cat in (ViewBag.Categorias as List<MultiserviciosPiscinas.Models.CategoriaProducto>) ?? new List<MultiserviciosPiscinas.Models.CategoriaProducto>())
                        {
                            <option value="@cat.Id"
                                    selected="@(cat.Id == (int)ViewBag.CategoriaSeleccionada ? "selected" : null)">
                                @cat.NombreCategoria
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Precio" class="form-label">Precio (₡)</label>
                    <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Stock" class="form-label">Stock disponible</label>
                    <input asp-for="Stock" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select asp-for="Activo" class="form-select">
                        <option value="true">Disponible</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>

                <div class="col-md-12">
                    <label for="imagen" class="form-label">Imagen del producto <span class="text-muted">(opcional)</span></label>
                    @if (!string.IsNullOrEmpty(Model.ImagenRuta))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImagenRuta" alt="Imagen del producto" class="img-fluid img-thumbnail c-prod-img-sm" />
                        </div>
                    }
                    <input type="file" name="imagen" id="imagen" class="form-control" accept=".jpg,.jpeg,.png" />
                    @Html.ValidationMessage("imagen", new { @class = "text-danger small" })
                </div>

                <div class="col-md-12">
                    <label asp-for="Descripcion" class="form-label">Descripción <span class="text-muted">(opcional)</span></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Guardar cambios
                </button>
            </div>

        </form>
    </div>
</div>

<div class="modal fade" id="modalCrearCategoria" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-start">
            <form asp-controller="Inventario" asp-action="CrearCategoria" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fs-6"><i class="bi bi-tags-fill me-2"></i>Nueva Categoría de Inventario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <label for="nombreCategoriaEditar" class="form-label fw-bold text-dark">Nombre de la categoría:</label>
                    <input type="text" id="nombreCategoriaEditar" name="nombreCategoria" class="form-control" maxlength="100" required placeholder="Ej: Químicos, Accesorios de Limpieza..." />
                </div>

                <div class="modal-footer bg-light d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle-fill me-1"></i>Guardar categoría
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
