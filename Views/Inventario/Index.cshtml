@model List<MultiserviciosPiscinas.Models.Producto>
@{
    ViewData["Title"] = "Inventario";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>Inventario</h2>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nuevo producto</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="c-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <input type="text" name="busqueda" value="@ViewBag.Busqueda"
               class="form-control c-filter-input" placeholder="Buscar por nombre..." />
        <button type="submit" class="btn btn-success">
            <i class="bi bi-search me-1"></i>Buscar
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Limpiar</a>
        }
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaInventario" class="table table-hover align-middle">
                <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Stock</th>
                <th>Precio</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int c = 1;
                foreach (var p in Model)
                {
                    <tr>
                        <td class="c-num">@c</td>
                        <td class="fw-semibold">@p.Nombre</td>
                        <td>@p.Categoria.NombreCategoria</td>
                        <td>@p.Stock</td>
                        <td class="c-price">₡@p.Precio.ToString("N2")</td>
                        <td>
                            @if (p.Activo)
                            {
                                <span class="c-badge c-badge-green">Disponible</span>
                            }
                            else
                            {
                                <span class="c-badge c-badge-red">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Detalle" asp-route-id="@p.Id" class="dropdown-item">
                                            <i class="bi bi-eye me-2 text-info"></i>Ver
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-action="Editar" asp-route-id="@p.Id" class="dropdown-item">
                                            <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                        </a>
                                    </li>
                                    @if (p.Activo)
                                    {
                                        <li>
                                            <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="dropdown-item text-danger btn-eliminar">
                                                    <i class="bi bi-slash-circle me-2 text-danger"></i>Desactivar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-action="Activar" asp-route-id="@p.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="dropdown-item text-success btn-activar">
                                                    <i class="bi bi-check-circle me-2 text-success"></i>Activar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                    c++;
                }
            }
        </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/inventario.js" asp-append-version="true"></script>
}
