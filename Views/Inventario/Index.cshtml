@model List<MultiserviciosPiscinas.Models.Producto>
@{
    ViewData["Title"] = "Inventario";
}

<div class="c-page-header d-flex justify-content-between align-items-center">
    <h2>Inventario</h2>
    @if (User.IsInRole("1"))
    {
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCategorias">
                <i class="bi bi-tags me-1"></i>Categorías
            </button>
            <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nuevo producto</a>
        </div>
    }
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaInventario" class="table table-hover align-middle">
                <thead class="table-light">
            <tr>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Stock</th>
                <th>Precio</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int c = 1;
                foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.Nombre</td>
                        <td>@p.Categoria.NombreCategoria</td>
                        <td>@p.Stock</td>
                        <td class="c-price">₡@p.Precio.ToString("N2")</td>
                        <td>
                            @if (p.Activo)
                            {
                                <span class="c-badge c-badge-green">Disponible</span>
                            }
                            else
                            {
                                <span class="c-badge c-badge-red">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical me-1"></i>Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-action="Detalle" asp-route-id="@p.Id" class="dropdown-item">
                                            <i class="bi bi-eye me-2 text-info"></i>Ver
                                        </a>
                                    </li>
                                    @if (User.IsInRole("1"))
                                    {
                                        <li>
                                            <a asp-action="Editar" asp-route-id="@p.Id" class="dropdown-item">
                                                <i class="bi bi-pencil me-2 text-warning"></i>Editar
                                            </a>
                                        </li>
                                        if (p.Activo)
                                        {
                                            <li>
                                                <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="dropdown-item text-danger btn-eliminar">
                                                        <i class="bi bi-slash-circle me-2 text-danger"></i>Desactivar
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <form asp-action="Activar" asp-route-id="@p.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="dropdown-item text-success btn-activar">
                                                        <i class="bi bi-check-circle me-2 text-success"></i>Activar
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                    c++;
                }
            }
        </tbody>
            </table>
        </div>
    </div>
</div>

@if (User.IsInRole("1"))
{
    var categoriasInventario = (ViewBag.Categorias as List<MultiserviciosPiscinas.Models.CategoriaProducto>)
        ?? new List<MultiserviciosPiscinas.Models.CategoriaProducto>();

    <div class="modal fade" id="modalCategorias" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-start">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fs-6"><i class="bi bi-tags-fill me-2"></i>Categorías de Inventario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form asp-controller="Inventario" asp-action="CrearCategoria" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <label for="nombreCategoriaNueva" class="form-label fw-bold text-dark">Agregar nueva categoría:</label>
                        <div class="input-group">
                            <input type="text" id="nombreCategoriaNueva" name="nombreCategoria" class="form-control" maxlength="100" required placeholder="Ej: Químicos, Accesorios de Limpieza..." />
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>Agregar
                            </button>
                        </div>
                    </form>

                    <label class="form-label fw-bold text-dark">Categorías existentes:</label>
                    @if (categoriasInventario.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var cat in categoriasInventario)
                            {
                                <form asp-controller="Inventario" asp-action="EditarCategoria" method="post" class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@cat.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <input type="text" name="nombreCategoria" value="@cat.NombreCategoria" class="form-control form-control-sm" maxlength="100" required />
                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                                        <i class="bi bi-save me-1"></i>Guardar
                                    </button>
                                </form>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No hay categorías registradas.</p>
                    }
                </div>

                <div class="modal-footer bg-light d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/inventario.js" asp-append-version="true"></script>
}
