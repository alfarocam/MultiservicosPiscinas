@model MultiserviciosPiscinas.Models.Producto
@{
    ViewData["Title"] = "Detalle del producto";
}

<div class="c-page-header">
    <h2><i class="bi bi-box-seam me-2"></i>@Model.Nombre</h2>
    @if (Model.Activo)
    {
        <span class="c-badge c-badge-lg c-badge-green">✓ Disponible</span>
    }
    else
    {
        <span class="c-badge c-badge-lg c-badge-gray">Inactivo</span>
    }
</div>

<div class="c-detail-card">
    <div class="row g-3 mb-4">
        @if (!string.IsNullOrEmpty(Model.ImagenRuta))
        {
            <div class="col-md-12 mb-3">
                <img src="@Model.ImagenRuta" alt="Imagen del producto" class="img-fluid img-thumbnail c-prod-img-lg" />
            </div>
        }
        <div class="col-md-6">
            <div class="c-detail-field">
                <label>Categoría</label>
                <p>@Model.Categoria.NombreCategoria</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="c-detail-field c-field-blue">
                <label>Precio unitario</label>
                <p>₡@Model.Precio.ToString("N2")</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="c-detail-field c-field-amber">
                <label>Stock disponible</label>
                <p>@Model.Stock unidades</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <div class="col-12">
                <div class="c-detail-field c-field-gray">
                    <label>Descripción</label>
                    <p>@Model.Descripcion</p>
                </div>
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>Editar producto
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver al listado
        </a>
    </div>
</div>
